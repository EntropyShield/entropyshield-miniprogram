page {
  background-color: #000000;
  min-height: 100%;
}

.page {
  background-color: #000000;
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 标题区 */
.title-container {
  text-align: left;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2aff2a;
}

.sub-title {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #c0c0c0;
  margin-top: 10rpx;
}

/* 入口信息 */
.entry-meta-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.entry-meta-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #d8d8d8;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

/* 提示卡 */
.quick-tip-card {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(42, 255, 42, 0.08);
  border: 1px solid rgba(42, 255, 42, 0.26);
}

.quick-tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2aff2a;
  margin-bottom: 8rpx;
}

.quick-tip-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #d8d8d8;
}

/* 全局错误 */
.global-error-box {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 107, 107, 0.12);
  border: 1px solid rgba(255, 107, 107, 0.28);
}

.global-error-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #ff8f8f;
}

/* 权益条 */
.rights-banner,
.rights-bar {
  margin-top: 4rpx;
  margin-bottom: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(42, 255, 42, 0.06);
  border: 1px solid rgba(42, 255, 42, 0.4);
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  row-gap: 6rpx;
}

.rights-label {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-right: 8rpx;
}

.rights-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
  color: #2aff2a;
}

/* 输入区 */
.input-container {
  margin-top: 10rpx;
}

.input-field {
  margin-bottom: 28rpx;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.input-label {
  font-size: 28rpx;
  color: #ffffff;
  display: block;
}

.label-tag {
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

.required-tag {
  color: #000000;
  background: #2aff2a;
}

.input {
  width: 100%;
  height: 90rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 2rpx solid #2aff2a;
  border-radius: 16rpx;
  background-color: #000000;
  color: #ffffff;
  font-size: 30rpx;
}

.input-error {
  border-color: #ff6b6b;
  box-shadow: 0 0 0 2rpx rgba(255, 107, 107, 0.12);
}

.field-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9aa0a6;
}

.field-error {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #ff6b6b;
}

/* 按钮区 */
.button-container {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-tip {
  width: 85%;
  display: block;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #d8d8d8;
  text-align: left;
}

.btn-primary,
.btn-secondary {
  width: 85%;
  padding: 22rpx 0;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.btn-primary {
  background-color: #2aff2a;
}

.btn-secondary {
  background-color: transparent;
  border: 2rpx solid rgba(42, 255, 42, 0.5);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
}

.btn-text-secondary {
  color: #2aff2a;
}

.btn-icon {
  position: absolute;
  right: 40rpx;
  font-size: 32rpx;
  color: #000000;
}

.btn-icon-secondary {
  color: #2aff2a;
}

.btn-disabled {
  opacity: 0.68;
}

.advanced-note {
  width: 85%;
  display: block;
  margin-top: -4rpx;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9aa0a6;
  text-align: left;
}

.entry-note {
  width: 85%;
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7f8790;
  text-align: left;
}

/* 返回按钮 */
.btn-back {
  width: 90%;
  height: 88rpx;
  margin: 30rpx auto 0;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx solid #2aff2a;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #000000;
  box-sizing: border-box;
}
.rc-rights-inline-card {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 16rpx;
  min-height: 88rpx;
}

.rc-rights-inline-label {
  display: inline-block !important;
  font-size: 24rpx !important;
  color: #cfd6df !important;
  line-height: 1.5 !important;
  white-space: nowrap !important;
}

.rc-rights-inline-value {
  display: inline-block !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  color: #2aff2a !important;
  line-height: 1.5 !important;
  text-align: right !important;
  white-space: nowrap !important;
}

.rc-plan-btn-unified {
  width: 100% !important;
  min-height: 96rpx !important;
  height: 96rpx !important;
  border-radius: 20rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  padding: 0 24rpx !important;
}

.rc-plan-btn-primary-unified {
  background: #2aff2a !important;
  color: #020305 !important;
  border: none !important;
}

.rc-plan-btn-secondary-unified {
  background: transparent !important;
  color: #2aff2a !important;
  border: 2rpx solid rgba(42, 255, 42, 0.6) !important;
}
/* ===== riskCalculator hardfix override ===== */
.rc-page {
  min-height: 100vh;
  background: #000000;
  padding: 24rpx;
  box-sizing: border-box;
}

.rights-banner {
  display: block !important;
  padding: 20rpx 24rpx !important;
}

.rights-inline-row {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 18rpx !important;
  width: 100% !important;
}

.rights-label {
  flex: 0 0 auto !important;
  display: inline-flex !important;
  align-items: center !important;
  font-size: 24rpx !important;
  color: #cfd6df !important;
  line-height: 1.5 !important;
  white-space: nowrap !important;
}

.rights-text {
  flex: 0 0 auto !important;
  display: inline-flex !important;
  align-items: center !important;
  text-align: left !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  color: #2aff2a !important;
  line-height: 1.5 !important;
  white-space: nowrap !important;
}

.button-container {
  display: flex !important;
  flex-direction: column !important;
  gap: 18rpx !important;
}

.btn-primary,
.btn-secondary {
  width: 100% !important;
  min-height: 96rpx !important;
  height: 96rpx !important;
  border-radius: 20rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  padding: 0 64rpx 0 24rpx !important;
  position: relative !important;
}

.btn-primary {
  background: #2aff2a !important;
  color: #020305 !important;
  border: none !important;
}

.btn-secondary {
  background: transparent !important;
  color: #2aff2a !important;
  border: 2rpx solid rgba(42, 255, 42, 0.6) !important;
}

.btn-text,
.btn-text-secondary {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  height: 100% !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  line-height: 1 !important;
  text-align: center !important;
}

.btn-text {
  color: #020305 !important;
}

.btn-text-secondary {
  color: #2aff2a !important;
}

.btn-icon,
.btn-icon-secondary {
  position: absolute !important;
  top: 50% !important;
  right: 32rpx !important;
  transform: translateY(-50%) !important;
  font-size: 28rpx !important;
}

.btn-icon {
  color: #020305 !important;
}

.btn-icon-secondary {
  color: #2aff2a !important;
}
/* ===== riskCalculator micro align ===== */
.rights-banner {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
}

.rights-inline-row {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
  gap: 12rpx !important;
  width: auto !important;
  min-width: 0 !important;
}

.rights-label {
  flex: none !important;
  width: auto !important;
  margin: 0 !important;
  padding: 0 !important;
}

.rights-text {
  flex: none !important;
  width: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  text-align: left !important;
}

.btn-text,
.btn-text-secondary {
  position: relative !important;
  top: -1rpx !important;
}
/* ===== riskCalculator rights tune 2 ===== */
.rights-inline-row {
  gap: 24rpx !important;
}

.rights-label,
.rights-text {
  font-size: 24rpx !important;
  line-height: 1.5 !important;
}

.rights-text {
  font-weight: 600 !important;
}
/* ===== riskCalculator rights final ===== */
.rights-banner {
  display: block !important;
  padding: 20rpx 24rpx !important;
}

.rights-inline-row {
  display: flex !important;
  align-items: flex-start !important;
  justify-content: flex-start !important;
  gap: 24rpx !important;
  width: 100% !important;
}

.rights-label {
  flex: 0 0 auto !important;
  width: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  font-size: 24rpx !important;
  line-height: 36rpx !important;
  font-weight: 600 !important;
  color: #cfd6df !important;
  white-space: nowrap !important;
}

.rights-text {
  flex: 1 1 auto !important;
  width: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  font-size: 24rpx !important;
  line-height: 36rpx !important;
  font-weight: 600 !important;
  color: #2aff2a !important;
  text-align: left !important;
  white-space: normal !important;
  word-break: break-all !important;
}
/* ===== riskCalculator rights textflow final ===== */
.rights-banner {
  display: block !important;
  padding: 20rpx 24rpx !important;
}

.rights-inline-flow {
  display: block !important;
  width: 100% !important;
  font-size: 0 !important;
  line-height: 0 !important;
}

.rights-inline-label,
.rights-inline-value {
  display: inline !important;
  vertical-align: baseline !important;
  font-size: 24rpx !important;
  line-height: 36rpx !important;
  font-weight: 600 !important;
}

.rights-inline-label {
  color: #cfd6df !important;
  margin-right: 24rpx !important;
  white-space: nowrap !important;
}

.rights-inline-value {
  color: #2aff2a !important;
  white-space: normal !important;
  word-break: break-all !important;
}
/* ===== riskCalculator fill secondary final ===== */
.btn-secondary {
  background: #2aff2a !important;
  color: #020305 !important;
  border: none !important;
}

.btn-text-secondary {
  color: #020305 !important;
}

.btn-icon-secondary {
  color: #020305 !important;
}