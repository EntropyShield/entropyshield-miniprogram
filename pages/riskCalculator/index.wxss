page {
  background-color: var(--es-ink, #03060C);
  min-height: 100%;
}

.page {
  background-color: var(--es-ink, #03060C);
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 标题区 */
.title-container {
  text-align: left;
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
}

.sub-title {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--es-txt-4, #7B8591);
  margin-top: 10rpx;
}

/* 入口信息 */
.entry-meta-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.entry-meta-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--es-txt-4, #7B8591);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

/* 提示卡 */
.quick-tip-card {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(0, 191, 255, 0.08);
  border: 1px solid rgba(0, 191, 255, 0.26);
}

.quick-tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
  margin-bottom: 8rpx;
}

.quick-tip-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--es-txt-4, #7B8591);
}

/* 全局错误 */
.global-error-box {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 107, 107, 0.12);
  border: 1px solid rgba(255, 107, 107, 0.28);
}

.global-error-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #ff8f8f;
}

/* 权益条 */
.rights-banner,
.rights-bar {
  margin-top: 4rpx;
  margin-bottom: 24rpx;
  padding: 14rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(0, 191, 255, 0.06);
  border: 1px solid rgba(0, 191, 255, 0.4);
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  row-gap: 6rpx;
}

.rights-label {
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
  margin-right: 8rpx;
}

.rights-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--es-green, #00BFFF);
}

/* 输入区 */
.input-container {
  margin-top: 10rpx;
}

.input-field {
  margin-bottom: 28rpx;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.input-label {
  font-size: 28rpx;
  color: var(--es-white, #F4F7FA);
  display: block;
}

.label-tag {
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

.required-tag {
  color: var(--es-ink, #03060C);
  background: var(--es-green, #00BFFF);
}

.input {
  width: 100%;
  height: 90rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 2rpx solid var(--es-green, #00BFFF);
  border-radius: 16rpx;
  background-color: var(--es-ink, #03060C);
  color: var(--es-white, #F4F7FA);
  font-size: 30rpx;
}

.input-error {
  border-color: #ff6b6b;
  box-shadow: 0 0 0 2rpx rgba(255, 107, 107, 0.12);
}

.field-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--es-txt-2, #AAB4BE);
}

.field-error {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #ff6b6b;
}

/* 选择器与固定风险 */
.picker-shell {
  width: 100%;
  min-height: 90rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--es-green, #00BFFF);
  border-radius: 16rpx;
  background-color: var(--es-ink, #03060C);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-shell-column {
  align-items: stretch;
  flex-direction: column;
}

.picker-main-row,
.risk-rule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  font-size: 30rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
}

.picker-arrow {
  font-size: 38rpx;
  color: var(--es-green, #00BFFF);
  line-height: 1;
}

.picker-desc {
  display: block;
  margin-top: 8rpx;
  padding-right: 40rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--es-txt-2, #AAB4BE);
}

.risk-rule-card {
  margin-top: 4rpx;
  margin-bottom: 30rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: rgba(0, 191, 255, 0.08);
  border: 1px solid rgba(0, 191, 255, 0.35);
}

.risk-rule-label {
  font-size: 28rpx;
  color: var(--es-white, #F4F7FA);
}

.risk-rule-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
}

.risk-rule-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--es-txt-4, #7B8591);
}

/* 按钮区 */
.button-container {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta-tip {
  width: 85%;
  display: block;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--es-txt-4, #7B8591);
  text-align: left;
}

.btn-primary,
.btn-secondary {
  width: 85%;
  padding: 22rpx 0;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.btn-primary {
  background-color: var(--es-green, #00BFFF);
}

.btn-secondary {
  background-color: transparent;
  border: 2rpx solid rgba(0, 191, 255, 0.5);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--es-ink, #03060C);
}

.btn-text-secondary {
  color: var(--es-green, #00BFFF);
}

.btn-icon {
  position: absolute;
  right: 40rpx;
  font-size: 32rpx;
  color: var(--es-ink, #03060C);
}

.btn-icon-secondary {
  color: var(--es-green, #00BFFF);
}

.btn-disabled {
  opacity: 0.68;
}

.advanced-note {
  width: 85%;
  display: block;
  margin-top: -4rpx;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--es-txt-2, #AAB4BE);
  text-align: left;
}

.entry-note {
  width: 85%;
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7f8790;
  text-align: left;
}

/* 返回按钮 */
.btn-back {
  width: 90%;
  height: 88rpx;
  margin: 30rpx auto 0;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx solid var(--es-green, #00BFFF);
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--es-white, #F4F7FA);
  background-color: var(--es-ink, #03060C);
  box-sizing: border-box;
}
.rc-rights-inline-card {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 16rpx;
  min-height: 88rpx;
}

.rc-rights-inline-label {
  display: inline-block !important;
  font-size: 24rpx !important;
  color: var(--es-txt-4, #7B8591) !important;
  line-height: 1.5 !important;
  white-space: nowrap !important;
}

.rc-rights-inline-value {
  display: inline-block !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  color: var(--es-green, #00BFFF) !important;
  line-height: 1.5 !important;
  text-align: right !important;
  white-space: nowrap !important;
}

.rc-plan-btn-unified {
  width: 100% !important;
