<view class="page risk-calculator">
  <view class="title-container">
    <text class="title">风控计算器</text>
    <text class="sub-title">一次填写完整参数，直接生成稳健版或加强版风控方案。</text>
  </view>

  <view class="compliance-banner">
    <text class="compliance-text">熵盾只做风控测算，不替你做买卖决策；是否执行、何时执行、是否调整，全部由你本人决定。</text>
  </view>

  <view class="quick-tip-card">
    <text class="quick-tip-title">填写基础参数</text>
    <text class="quick-tip-text">依次填写标的、资金和买入执行价，再选择仓位比例、分批进场模板与止损策略。</text>
  </view>

  <view class="rights-banner">
    <view class="rights-row">
      <text class="rights-label">会员权益：</text>
      <text class="rights-text">{{membershipName || '未开通'}}</text>
    </view>

    <view class="rights-row">
      <text class="rights-label">到期状态：</text>
      <block wx:if="{{membershipName}}">
        <text class="rights-text" wx:if="{{remainingDays > 0}}">剩余 {{remainingDays}} 天</text>
        <text class="rights-text" wx:else>已到期</text>
      </block>
      <text class="rights-text" wx:else>—</text>
    </view>

    <view class="rights-row">
      <text class="rights-label">任务权益：</text>
      <text class="rights-text">{{freeCalcTimes}} 次</text>
    </view>
  </view>

  <view class="input-container">
    <view class="input-field">
      <view class="label-row">
        <text class="input-label">标的代码／名称</text>
        <text class="label-tag required-tag">必填</text>
      </view>
      <input
        class="input {{codeError ? 'input-error' : ''}}"
        placeholder="例如：000001 或 平安银行"
        bindinput="onCodeInput"
        value="{{code}}"
        confirm-type="next"
      />
      <text class="field-tip">用于方案记录、统计与后续跟踪。</text>
      <text class="field-error" wx:if="{{codeError}}">{{codeError}}</text>
    </view>

    <view class="input-field">
      <view class="label-row">
        <text class="input-label">账户可用资金（元）</text>
        <text class="label-tag required-tag">必填</text>
      </view>
      <input
        class="input {{balanceError ? 'input-error' : ''}}"
        type="digit"
        placeholder="例如：100000"
        bindinput="onBalanceInput"
        value="{{balance}}"
        confirm-type="next"
      />
      <text class="field-tip">填写本次计划可用于风险测算的账户资金。</text>
      <text class="field-error" wx:if="{{balanceError}}">{{balanceError}}</text>
    </view>

    <view class="input-field">
      <view class="label-row">
        <text class="input-label">买入执行价</text>
        <text class="label-tag required-tag">必填</text>
      </view>
      <input
        class="input {{priceError ? 'input-error' : ''}}"
        type="digit"
        placeholder="例如：12.36"
        bindinput="onPriceInput"
        value="{{price}}"
        confirm-type="next"
      />
      <text class="field-tip">填写本次计划首次执行买入的价格。</text>
      <text class="field-error" wx:if="{{priceError}}">{{priceError}}</text>
    </view>

    <view class="input-field">
      <view class="label-row">
        <text class="input-label">仓位比例</text>
        <text class="label-tag required-tag">必选</text>
      </view>
      <picker range="{{deployRatioOptions}}" range-key="label" value="{{deployRatioIndex}}" bindchange="onDeployRatioChange">
        <view class="picker-shell">
          <text class="picker-value">{{deployRatioOptions[deployRatioIndex].label}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
      <text class="field-tip">可选30%—80%，默认80%。后续价格上涨和整手交易可能形成实际投入偏差。</text>
    </view>

    <view class="input-field">
      <view class="label-row">
        <text class="input-label">分批进场模板</text>
        <text class="label-tag required-tag">必选</text>
      </view>
      <picker range="{{templateOptions}}" range-key="label" value="{{templateIndex}}" bindchange="onTemplateChange">
        <view class="picker-shell picker-shell-column">
          <view class="picker-main-row">
            <text class="picker-value">{{templateOptions[templateIndex].label}}</text>
            <text class="picker-arrow">›</text>
          </view>
          <text class="picker-desc">{{templateOptions[templateIndex].description}}</text>
        </view>
      </picker>
      <text class="field-tip">加强版模板为5:2:3、4:3:3、6:2:2，需使用加强版权益。</text>
    </view>

    <view class="input-field">
      <view class="label-row">
        <text class="input-label">止损策略</text>
        <text class="label-tag required-tag">必选</text>
      </view>
      <picker range="{{stopModeOptions}}" range-key="label" value="{{stopModeIndex}}" bindchange="onStopModeChange">
        <view class="picker-shell picker-shell-column">
          <view class="picker-main-row">
            <text class="picker-value">{{stopModeOptions[stopModeIndex].label}}</text>
            <text class="picker-arrow">›</text>
          </view>
          <text class="picker-desc">{{stopModeOptions[stopModeIndex].description}}</text>
        </view>
      </picker>
    </view>

    <view class="input-field">
      <view class="label-row">
        <text class="input-label">单笔最大可承受亏损</text>
        <text class="label-tag required-tag">必选</text>
      </view>
      <view class="risk-budget-row">
        <slider class="risk-budget-slider" min="0.5" max="3" step="0.5" value="{{riskBudgetPct}}" bindchange="onRiskBudgetChange" activeColor="var(--es-brand, #00BFFF)" block-color="var(--es-brand, #00BFFF)" />
        <text class="risk-budget-value">{{riskBudgetPct}}%</text>
      </view>
      <text class="field-tip">你愿意为这一笔交易承担的最大亏损占账户可用资金的比例，由你本人设定，熵盾据此反推各批止损价。</text>
    </view>

    <view class="input-field">
      <view class="label-row">
        <text class="input-label">已有持仓（股，可选）</text>
        <text class="label-tag optional-tag">可选</text>
      </view>
      <input class="input" type="digit" placeholder="例如：1000（仅用于总风险测算）" bindinput="onHeldSharesInput" value="{{heldShares}}" />
      <text class="field-tip">若已持有该标的，填写后方案会一并测算总风险；不填则只算本次新建仓。</text>
    </view>

    <view class="input-field" wx:if="{{versionTab === 'advanced'}}">
      <view class="label-row">
        <text class="input-label">逐批进场价（可选）</text>
        <text class="label-tag optional-tag">可选</text>
      </view>
      <view class="manual-toggle">
        <text class="manual-toggle-text">手动设定每批买价（默认按模板梯度自动递增）</text>
        <switch checked="{{manualPrices}}" bindchange="onManualPricesToggle" color="var(--es-brand, #00BFFF)" />
      </view>
      <view wx:if="{{manualPrices}}" class="batch-price-list">
        <view class="batch-price-item" wx:for="{{batchLabels}}" wx:key="index" wx:for-index="bidx">
          <text class="batch-price-label">{{item}}</text>
          <input class="input batch-price-input" type="digit" placeholder="买价" value="{{batchPrices[bidx]}}" data-idx="{{bidx}}" bindinput="onBatchPriceInput" />
        </view>
      </view>
    </view>
  </view>

  <view class="button-container">
    <text class="cta-tip">所选版本与模板一致；点击后直接计算并进入完整结果页。所有参数由你本人决定，熵盾不替你下单。</text>

    <view class="btn-primary rc-plan-btn-unified rc-plan-btn-primary-unified" bindtap="onClickGenerate">
      <text class="btn-text">生成我的风控方案</text>
      <text class="btn-icon">→</text>
    </view>

    <text class="advanced-note" wx:if="{{versionTab === 'advanced' && advancedEnabled}}">当前会员权益可直接使用加强版。</text>
    <text class="advanced-note" wx:if="{{versionTab === 'advanced' && !advancedEnabled}}">加强版仅对季度会员、年度会员和终身权益开放。</text>
    <text class="advanced-note" wx:if="{{versionTab === 'steady'}}">稳健版对所有可用用户开放。</text>
  </view>

  <view class="btn-back" bindtap="goHome">返回首页</view>
</view>
