<!-- pages/controller/index.wxml · [V2.0-G3] 风控中心 → 风控工作台（24 号原型落地） -->
<!-- 改造要点：删掉与首页四宫格/更多入口 100% 重复的"核心风控功能""风控能力训练"，
     以及 hero 说教卡；换成"每天要干活的地方"：执行率 + 今日清单 + 快捷动作 + 方案/记录/报告三段。 -->
<view class="page">

  <!-- ① 工作台头部：轻量，无 hero、无说教 -->
  <view class="wb-head">
    <view class="wb-head-l">
      <view class="wb-title">风控工作台</view>
      <view class="wb-sub">{{wbDateText}}</view>
    </view>
    <view class="wb-chip">
      <text class="wb-chip-k">今日清单</text>
      <text class="wb-chip-v">{{wbDoneCount}} / {{wbTotalCount}}</text>
    </view>
  </view>

  <!-- ② 本周纪律执行率 -->
  <view class="rate-card">
    <view class="rate-top">
      <text class="rate-k">本周纪律执行率</text>
      <text class="rate-v" wx:if="{{wbRateReady}}">{{wbRate}}% · 高于你的均值</text>
      <!-- 后端 /api/discipline/weekly 未就绪：诚实占位，不编造百分比 -->
      <text class="rate-v rate-v-idle" wx:else>数据积累中</text>
    </view>

    <view class="rate-row">
      <block wx:for="{{wbWeekCells}}" wx:key="label">
        <view class="rate-cell {{item.state === 'hit' ? 'hit' : ''}} {{item.isToday ? 'today' : ''}}">
          <text>{{item.label}}</text>
        </view>
      </block>
    </view>

    <view class="rate-note">
      连续守纪 <text class="rate-em">{{wbStreak}}</text> 天 · 逐日执行率待后端统计接口就绪后自动填充
    </view>
  </view>

  <!-- ③ 今日执行清单 -->
  <view class="wb-sec">
    <view class="sec-head">
      <text class="sec-h3">今日执行清单</text>
      <text class="sec-r">完成 <text class="sec-rb">{{wbDoneCount}}</text>/{{wbTotalCount}}</text>
    </view>

    <view class="wb-list">
      <block wx:for="{{todoList}}" wx:key="key">
        <view class="wb-item" bindtap="onTodoTap" data-item="{{item}}">
          <view class="wb-item-l">
            <view class="wb-cb {{item.done ? 'done' : ''}}">
              <text wx:if="{{item.done}}">✓</text>
            </view>
            <view class="wb-item-txt">
              <view class="wb-item-nm {{item.done ? 'dim' : ''}}">{{item.name}}</view>
              <view class="wb-item-d">{{item.desc}}</view>
            </view>
          </view>
          <text class="wb-tag {{item.done ? 't-safe' : 't-warn'}}">{{item.done ? '完成' : '待办'}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- ④ 快捷动作条：计算器降级为其中一个动作，不再是整页主角 -->
  <view class="wb-quick">
    <view class="qbtn" bindtap="goCalc">
      <text class="q-ico">▦</text>
      <text class="q-t">风控测算</text>
      <text class="q-s">开仓必过</text>
    </view>
    <view class="qbtn" bindtap="goTradeRecord">
      <text class="q-ico">✎</text>
      <text class="q-t">记一笔</text>
      <text class="q-s">持仓/执行</text>
    </view>
    <view class="qbtn" bindtap="goLongArchive">
      <text class="q-ico">◆</text>
      <text class="q-t">写复盘</text>
      <text class="q-s">沉淀档案</text>
    </view>
  </view>

  <!-- ⑤ 内部分段：存续方案 / 执行记录 / 报告 -->
  <view class="wb-seg">
    <view class="seg-item {{wbSeg === 0 ? 'on' : ''}}" data-seg="0" bindtap="onSegChange">存续方案 {{wbPlans.length}}</view>
    <view class="seg-item {{wbSeg === 1 ? 'on' : ''}}" data-seg="1" bindtap="onSegChange">执行记录</view>
    <view class="seg-item {{wbSeg === 2 ? 'on' : ''}}" data-seg="2" bindtap="onSegChange">报告</view>
  </view>

  <!-- 5-1 存续方案：让每个方案成为"活物" -->
  <view class="wb-sec" wx:if="{{wbSeg === 0}}">
    <block wx:for="{{wbPlans}}" wx:key="name">
      <view class="plan-card" bindtap="onPlanTap">
        <view class="plan-top">
          <view class="plan-top-l">
            <view class="plan-nm">{{item.name}}</view>
            <view class="plan-d">{{item.desc}}</view>
          </view>
          <text class="wb-tag {{item.hasStop ? 't-safe' : 't-danger'}}">{{item.hasStop ? '规则就位' : '待补止损'}}</text>
        </view>
        <view class="plan-stat">
          <view class="pstat"><text class="pstat-k">止损线</text><text class="pstat-v">{{item.stopText}}</text></view>
          <view class="pstat"><text class="pstat-k">状态</text><text class="pstat-v">{{item.hasStop ? '已设' : '未设'}}</text></view>
        </view>
      </view>
    </block>

    <view class="wb-empty" wx:if="{{!wbPlans.length}}">{{wbHint || '暂无存续方案'}}</view>
  </view>

  <!-- 5-2 执行记录 -->
  <view class="wb-sec" wx:if="{{wbSeg === 1}}">
    <view class="wb-list">
      <block wx:for="{{wbRecords}}" wx:key="name">
        <view class="rec">
          <view class="rec-l">
            <view class="rec-ico {{item.ok ? 'ok' : 'bad'}}">{{item.ok ? '✓' : '!'}}</view>
            <view class="rec-txt">
              <view class="rec-nm">{{item.name}}</view>
              <view class="rec-d">{{item.desc}}</view>
            </view>
          </view>
          <text class="wb-tag {{item.ok ? 't-safe' : 't-warn'}}">{{item.ok ? '守纪' : '待补'}}</text>
        </view>
      </block>
    </view>
    <view class="wb-empty" wx:if="{{!wbRecords.length}}">{{wbHint || '暂无执行记录'}}</view>
  </view>

  <!-- 5-3 报告 -->
  <view class="wb-sec" wx:if="{{wbSeg === 2}}">
    <view class="wb-list">
      <block wx:for="{{wbReports}}" wx:key="name">
        <view class="rep" bindtap="onReportTap" data-path="{{item.path}}">
          <view class="rep-top">
            <text class="rep-nm">{{item.name}}</text>
          </view>
          <view class="rep-d">{{item.desc}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- ⑥ 责任边界（保留，A3 合规要求） -->
  <view class="card notice-card">
    <view class="notice-title">风险与责任边界</view>
    <view class="notice-text">
      <text>熵盾提供风险信息、规则工具和风险管理支持。</text>
      <text>相关结果不构成投资建议，不替代用户独立判断和自主决策。</text>
    </view>
  </view>

  <disclaimer />
</view>
