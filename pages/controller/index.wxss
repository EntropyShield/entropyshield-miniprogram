/* pages/controller/index.wxss
   [V2.0-G3] 风控中心 → 风控工作台（24 号原型落地）
   改造前是"门面"：hero 说教 + 五大功能入口列表（与首页四宫格/更多入口 100% 重复）。
   改造后是"每天要干活的地方"：执行率 + 今日清单 + 快捷动作 + 方案/记录/报告三段。
   色值一律经 var() 并带 fallback（G1 令牌规范）。 */

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: var(--es-bg, #03060C);
  color: var(--es-txt-1, #F4F7FA);
}

/* ---------- ① 头部：轻量，无 hero ---------- */
.wb-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 8rpx 4rpx 20rpx;
}

.wb-title {
  font-size: var(--fs-lg, 36rpx);
  font-weight: 700;
  color: var(--es-txt-1, #F4F7FA);
}

.wb-sub {
  margin-top: 6rpx;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
}

.wb-chip {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: var(--radius-sm, 12rpx);
  background: var(--es-green-bg, rgba(0, 191, 255, .12));
  border: 2rpx solid rgba(0, 191, 255, .3);
  text-align: center;
}

.wb-chip-k {
  display: block;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-2, #AAB4BE);
}

.wb-chip-v {
  display: block;
  margin-top: 2rpx;
  font-size: var(--fs-md, 32rpx);
  font-weight: 700;
  color: var(--es-green, #00BFFF);
}

/* ---------- ② 本周纪律执行率 ---------- */
.rate-card {
  margin-bottom: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: var(--radius-md, 20rpx);
  background: linear-gradient(160deg, var(--es-elevated, #151F2C), var(--es-card, #07111E));
  border: 2rpx solid var(--es-line, #4B5663);
}

.rate-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.rate-k {
  font-size: var(--fs-base, 28rpx);
  font-weight: 600;
  color: var(--es-txt-1, #F4F7FA);
}

.rate-v {
  font-size: var(--fs-sm, 24rpx);
  color: var(--es-txt-2, #AAB4BE);
}

/* 后端未就绪：诚实占位，不伪装成 0% */
.rate-v-idle {
  color: var(--es-txt-3, #8E98A3);
  font-size: var(--fs-xs, 20rpx);
}

.rate-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.rate-cell {
  flex: 1;
  height: 44rpx;
  border-radius: 8rpx;
  background: var(--es-card, #07111E);
  border: 2rpx solid var(--es-line, #4B5663);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
}

.rate-cell.today {
  border-color: rgba(0, 191, 255, .5);
}

.rate-cell.hit {
  background: var(--es-green-bg, rgba(0, 191, 255, .16));
  border-color: rgba(0, 191, 255, .4);
  color: var(--es-green, #00BFFF);
}
.rate-cell.miss {
  border-color: rgba(255, 77, 94, .55);
  background: rgba(255, 77, 94, .08);
  color: var(--es-red, #FF4D5E);
}
.rate-cell.pending {
  background: var(--es-card, #07111E);
  border-color: var(--es-line, #4B5663);
  color: var(--es-txt-3, #8E98A3);
}

.rate-note {
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
  line-height: 1.6;
}

.rate-em {
  color: var(--es-amber, #FFB020);
  font-style: normal;
}

/* ---------- ③ 今日执行清单 ---------- */
.wb-sec {
  margin-bottom: 24rpx;
}

.sec-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.sec-h3 {
  font-size: var(--fs-md, 32rpx);
  font-weight: 600;
  color: var(--es-txt-1, #F4F7FA);
}

.sec-r {
  font-size: var(--fs-sm, 24rpx);
  color: var(--es-txt-3, #8E98A3);
}

.sec-rb {
  color: var(--es-green, #00BFFF);
  font-weight: 700;
}

.wb-list {
  background: var(--es-card, #07111E);
  border: 2rpx solid var(--es-line, #4B5663);
  border-radius: var(--radius-md, 20rpx);
  overflow: hidden;
}

.wb-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx;
  border-bottom: 2rpx solid var(--es-line, #4B5663);
}

.wb-item:last-child { border-bottom: none; }

.wb-item-l {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  flex: 1;
}

.wb-cb {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  border-radius: 10rpx;
  border: 3rpx solid var(--es-txt-3, #8E98A3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm, 24rpx);
  color: var(--es-on-green, #03060C);
}

.wb-cb.done {
  background: var(--es-safe, #00E5A0);
  border-color: var(--es-safe, #00E5A0);
}

.wb-item-txt { flex: 1; }

.wb-item-nm {
  font-size: var(--fs-base, 28rpx);
  font-weight: 500;
  color: var(--es-txt-1, #F4F7FA);
}

.wb-item-nm.dim {
  color: var(--es-txt-2, #AAB4BE);
  text-decoration: line-through;
}

.wb-item-d {
  margin-top: 6rpx;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
}

.wb-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: var(--fs-xs, 20rpx);
  font-weight: 600;
}

.t-safe {
  background: var(--es-safe-bg, rgba(0, 229, 160, .12));
  color: var(--es-safe, #00E5A0);
}

.t-warn {
  background: rgba(255, 176, 32, .12);
  color: var(--es-amber, #FFB020);
}

.t-danger {
  background: rgba(255, 77, 94, .12);
  color: var(--es-red, #FF4D5E);
}

/* ---------- ④ 快捷动作条 ---------- */
.wb-quick {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.qbtn {
  flex: 1;
  padding: 24rpx 12rpx;
  text-align: center;
  background: var(--es-card, #07111E);
  border: 2rpx solid var(--es-line, #4B5663);
  border-radius: var(--radius-md, 20rpx);
}

.q-ico {
  display: block;
  font-size: var(--fs-lg, 36rpx);
  color: var(--es-green, #00BFFF);
  margin-bottom: 8rpx;
}

.q-t {
  display: block;
  font-size: var(--fs-base, 28rpx);
  font-weight: 600;
  color: var(--es-txt-1, #F4F7FA);
}

.q-s {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
}

/* ---------- ⑤ 内部分段 ---------- */
.wb-seg {
  display: flex;
  margin-bottom: 20rpx;
  padding: 6rpx;
  background: var(--es-elevated, #151F2C);
  border: 2rpx solid var(--es-line, #4B5663);
  border-radius: var(--radius-sm, 12rpx);
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--fs-sm, 24rpx);
  color: var(--es-txt-2, #AAB4BE);
  border-radius: 10rpx;
}

.seg-item.on {
  background: var(--es-card, #07111E);
  color: var(--es-green, #00BFFF);
  font-weight: 600;
}

/* ---------- 5-1 存续方案 ---------- */
.plan-card {
  margin-bottom: 16rpx;
  padding: 26rpx;
  background: var(--es-card, #07111E);
  border: 2rpx solid var(--es-line, #4B5663);
  border-radius: var(--radius-md, 20rpx);
}

.plan-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.plan-top-l { flex: 1; }

.plan-nm {
  font-size: var(--fs-md, 32rpx);
  font-weight: 700;
  color: var(--es-txt-1, #F4F7FA);
}

.plan-d {
  margin-top: 6rpx;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
}

.plan-stat {
  display: flex;
  gap: 16rpx;
}

.pstat {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  background: var(--es-elevated, #151F2C);
  border: 2rpx solid var(--es-line, #4B5663);
  border-radius: var(--radius-sm, 12rpx);
}

.pstat-k {
  display: block;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
  margin-bottom: 6rpx;
}

.pstat-v {
  display: block;
  font-size: var(--fs-md, 32rpx);
  font-weight: 700;
  color: var(--es-txt-1, #F4F7FA);
}

/* ---------- 5-2 执行记录 ---------- */
.rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  border-bottom: 2rpx solid var(--es-line, #4B5663);
}

.rec:last-child { border-bottom: none; }

.rec-l {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  flex: 1;
}

.rec-ico {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--es-elevated, #151F2C);
  border: 2rpx solid var(--es-line, #4B5663);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-base, 28rpx);
}

.rec-ico.ok { color: var(--es-safe, #00E5A0); }
.rec-ico.bad { color: var(--es-red, #FF4D5E); }

.rec-txt { flex: 1; }

.rec-nm {
  font-size: var(--fs-base, 28rpx);
  font-weight: 500;
  color: var(--es-txt-1, #F4F7FA);
}

.rec-d {
  margin-top: 4rpx;
  font-size: var(--fs-xs, 20rpx);
  color: var(--es-txt-3, #8E98A3);
}

/* ---------- 5-3 报告 ---------- */
.rep {
  padding: 24rpx 26rpx;
  border-bottom: 2rpx solid var(--es-line, #4B5663);
}

.rep:last-child { border-bottom: none; }

.rep-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.rep-nm {
  font-size: var(--fs-base, 28rpx);
  font-weight: 600;
  color: var(--es-txt-1, #F4F7FA);
}

.rep-d {
  font-size: var(--fs-sm, 24rpx);
  color: var(--es-txt-2, #AAB4BE);
  line-height: 1.6;
}

/* ---------- 空态 ---------- */
.wb-empty {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: var(--fs-sm, 24rpx);
  color: var(--es-txt-3, #8E98A3);
  background: var(--es-card, #07111E);
  border: 2rpx dashed var(--es-line, #4B5663);
  border-radius: var(--radius-md, 20rpx);
}

/* ---------- ⑥ 责任边界（A3 合规，保留） ---------- */
.notice-card {
  padding: 24rpx 26rpx;
  border: 2rpx dashed var(--es-line, #4B5663);
  border-radius: var(--radius-md, 20rpx);
  background: var(--es-elevated, #151F2C);
}

.notice-title {
  margin-bottom: 10rpx;
  color: var(--es-txt-2, #AAB4BE);
  font-size: var(--fs-sm, 24rpx);
  font-weight: 600;
}

.notice-text text {
  display: block;
  margin-top: 6rpx;
  color: var(--es-txt-3, #8E98A3);
  font-size: var(--fs-sm, 24rpx);
  line-height: 1.86;
}
