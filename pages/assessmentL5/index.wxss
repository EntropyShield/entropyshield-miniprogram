.l5-wrap{padding:28rpx;background:#0b1726;color:#e7f2fd;min-height:100vh;box-sizing:border-box}.l5-header,.l5-section,.l5-question{background:#14273e;border:1rpx solid #29445d;border-radius:16rpx;padding:28rpx;margin-bottom:24rpx}.l5-title{font-size:36rpx;font-weight:700;margin-bottom:12rpx}.l5-note{font-size:24rpx;color:#aac0d7;line-height:1.7;margin-top:12rpx}.l5-label,.l5-stem{font-size:29rpx;font-weight:600;margin-bottom:22rpx;line-height:1.6}.l5-domains{display:flex;flex-wrap:wrap;gap:16rpx;margin-bottom:28rpx}.l5-domain{border:1rpx solid #59718b;padding:16rpx 26rpx;border-radius:10rpx}.selected{border-color:#52c3ef!important;background:#173e5c!important}.l5-option{border:1rpx solid #385571;padding:22rpx;border-radius:12rpx;margin-bottom:16rpx;font-size:27rpx;line-height:1.6}.l5-result{font-size:32rpx;font-weight:700;margin:18rpx 0}.l5-error{color:#ff8888;margin:24rpx}