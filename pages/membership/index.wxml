<view class="page">
  <view class="card">
    <view class="title">会员中心</view>

    <view class="row">
      <text class="label">当前状态</text>
      <text class="value">{{membershipName}}</text>
    </view>

    <view class="row">
      <text class="label">剩余完整方案</text>
      <text class="value">{{freeCalcTimes}}</text>
    </view>

    <view wx:if="{{membershipExpireText}}" class="row">
      <text class="label">到期时间</text>
      <text class="value">{{membershipExpireText}}</text>
    </view>

    <view wx:if="{{inviteCode}}" class="row">
      <text class="label">邀请码</text>
      <text class="value">{{inviteCode}}</text>
    </view>

    <view wx:if="{{isLifetimeMember}}" class="row">
      <text class="label">终身说明</text>
      <text class="value">终身会员仅限你自己的 ID 使用</text>
    </view>
  </view>

  <view class="card">
    <view class="title">风控计算器官方收费口径</view>

    <block wx:for="{{feeList}}" wx:key="key">
      <view class="row">
        <text class="label">{{item.name}}</text>
        <text class="value">{{item.rights}}</text>
      </view>
      <view class="row">
        <text class="label">说明</text>
        <text class="value">{{item.desc}}</text>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="row">
      <text class="label">产品</text>
      <text class="value">风控计算器</text>
    </view>
    <view class="row">
      <text class="label">对外售卖</text>
      <text class="value">9.9/3次、月卡999、季卡2999、年卡9999</text>
    </view>
  </view>

  <button class="btn" bindtap="goBack">返回</button>
</view>