.page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: var(--es-bg, #03060C);
  color: var(--es-white, #F4F7FA);
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--es-card, #07111E);
  border: 1px solid var(--es-line, rgba(255,255,255,0.06));
}

.hero-card {
  background: linear-gradient(180deg, rgba(0, 191, 255,0.10) 0%, var(--es-card, #07111E) 100%);
  border: 1px solid rgba(0, 191, 255,0.28);
}

.brand-mark {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border: 1px solid rgba(0, 191, 255,0.42);
  border-radius: 999rpx;
  background: rgba(0, 191, 255,0.08);
  color: var(--es-green, #00BFFF);
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--es-white, #F4F7FA);
  line-height: 1.4;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--es-txt-2, #AAB4BE);
}

/* 当前权益卡片 */
.current-card.is-member {
  border: 1px solid rgba(0, 191, 255,0.34);
  background: linear-gradient(180deg, rgba(0, 191, 255,0.08) 0%, var(--es-card, #07111E) 100%);
}

.current-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1px solid var(--es-line, rgba(255,255,255,0.05));
}

.current-row:last-of-type {
  border-bottom: none;
}

.current-label {
  color: var(--es-txt-2, #AAB4BE);
  font-size: 24rpx;
}

.current-value {
  color: var(--es-txt-1, #F4F7FA);
  font-size: 26rpx;
  font-weight: 600;
}

.current-tip {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.8;
  color: var(--es-txt-2, #AAB4BE);
}

/* 套餐列表 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--es-white, #F4F7FA);
}

.section-sub {
  margin-top: 10rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--es-txt-2, #AAB4BE);
}

.plan-card {
  position: relative;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--es-card-2, #0F1926);
  border: 1px solid var(--es-line, rgba(255,255,255,0.08));
  overflow: hidden;
}

.plan-highlight {
  border: 1px solid rgba(0, 191, 255,0.55);
  background: linear-gradient(180deg, rgba(0, 191, 255,0.08) 0%, var(--es-card-2, #0F1926) 100%);
}

.plan-flag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 16rpx;
  font-size: 20rpx;
  color: var(--es-on-green, #03060C);
  background: var(--es-green, #00BFFF);
  border-bottom-left-radius: 16rpx;
  font-weight: 700;
}

.plan-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--es-white, #F4F7FA);
}

.plan-price {
  display: flex;
  align-items: baseline;
}

.price-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
}

.price-cycle {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.plan-rights {
  margin-top: 12rpx;
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--es-green, #00BFFF);
  background: rgba(0, 191, 255,0.10);
  border: 1px solid rgba(0, 191, 255,0.30);
}

.plan-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--es-txt-2, #AAB4BE);
}

.plan-action {
  margin-top: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--es-green, #00BFFF);
}

/* 合规说明 */
.notice-card {
  background: var(--es-card, #07111E);
}

.notice-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--es-txt-2, #AAB4BE);
  margin-bottom: 10rpx;
}

.notice-item {
  font-size: 22rpx;
  line-height: 1.8;
  color: var(--es-txt-2, #AAB4BE);
}

.footer-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.btn-ghost {
  flex: 1;
  margin: 0;
  padding: 22rpx 0;
  font-size: 26rpx;
  color: var(--es-txt-2, #AAB4BE);
  background: transparent;
  border: 1px solid var(--es-line, rgba(255,255,255,0.14));
  border-radius: 16rpx;
}

.btn-ghost::after {
  border: none;
}
