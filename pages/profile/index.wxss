.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: var(--es-bg, #03060C);
  color: var(--es-white, #F4F7FA);
}

.card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border: 1px solid var(--es-line, rgba(255, 255, 255, 0.06));
  border-radius: 24rpx;
  background: var(--es-card, #07111E);
}

.section-title {
  color: var(--es-green, #00BFFF);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
  margin-bottom: 18rpx;
}

.nav-arrow {
  flex-shrink: 0;
  color: var(--es-green, #00BFFF);
  font-size: 30rpx;
}

/* ===== L1 身份铭牌层 ===== */
.badge-card {
  display: flex;
  align-items: center;
  border-color: rgba(0, 191, 255, 0.24);
  background: linear-gradient(180deg, rgba(0, 191, 255, 0.08) 0%, var(--es-card, #07111E) 100%);
}

.avatar-btn {
  width: 96rpx;
  height: 96rpx;
  margin: 0 18rpx 0 0;
  padding: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px solid rgba(0, 191, 255, 0.25);
  border-radius: 50%;
  background: var(--es-card-2, #0F1926);
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  color: var(--es-green, #00BFFF);
  font-size: 38rpx;
  font-weight: 700;
}

.badge-main {
  flex: 1;
  min-width: 0;
}

.nick-input {
  color: var(--es-white, #F4F7FA);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  min-height: 44rpx;
}

.nick-ph {
  color: var(--es-txt-2, #AAB4BE);
  font-weight: 400;
}

.badge-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.badge-level {
  padding: 5rpx 14rpx;
  border: 1px solid rgba(0, 191, 255, 0.4);
  border-radius: 999rpx;
  color: var(--es-green, #00BFFF);
  font-size: 21rpx;
  font-weight: 700;
}

.badge-streak {
  color: var(--es-txt-2, #AAB4BE);
  font-size: 22rpx;
}

.badge-setting {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  border-radius: 50%;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 34rpx;
  background: var(--es-card-2, #0F1926);
}

/* ===== L2 资产账本层 ===== */
.ledger-card {
  border-color: rgba(0, 191, 255, 0.18);
}

.ledger-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.ledger-title {
  color: var(--es-white, #F4F7FA);
  font-size: 30rpx;
  font-weight: 700;
}

.ledger-name {
  color: var(--es-green, #00BFFF);
  font-size: 24rpx;
  font-weight: 600;
}

.ledger-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.ledger-item {
  min-width: 0;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--es-line, rgba(255, 255, 255, 0.08));
  border-radius: 16rpx;
  background: var(--es-card-2, #0F1926);
}

.li-label {
  color: var(--es-txt-2, #AAB4BE);
  font-size: 20rpx;
}

.li-value {
  margin-top: 6rpx;
  color: var(--es-txt-4, #7B8591);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.ledger-action {
  margin-top: 18rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 999rpx;
  background: var(--es-green, #00BFFF);
  color: var(--es-on-green, #03060C);
  font-size: 26rpx;
  font-weight: 700;
}

/* ===== L3 战场层 ===== */
.battle-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1px solid var(--es-line, rgba(255, 255, 255, 0.05));
}

.battle-main {
  flex: 1;
  min-width: 0;
  padding-right: 14rpx;
}

.battle-name {
  display: block;
  color: var(--es-txt-4, #7B8591);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.battle-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 21rpx;
  line-height: 1.7;
}

.invite-box {
  margin-top: 18rpx;
  padding: 18rpx 16rpx;
  border: 1px solid rgba(0, 191, 255, 0.3);
  border-radius: 16rpx;
  background: var(--es-card-2, #0F1926);
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-code {
  color: var(--es-green, #00BFFF);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.invite-copy {
  padding: 8rpx 24rpx;
  border: 1px solid var(--es-green, #00BFFF);
  border-radius: 999rpx;
  color: var(--es-green, #00BFFF);
  font-size: 22rpx;
  font-weight: 600;
}

.invite-sub {
  display: block;
  margin-top: 10rpx;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 21rpx;
}

.archive-row {
  display: flex;
  margin-top: 18rpx;
  border: 1px solid var(--es-line, rgba(255, 255, 255, 0.08));
  border-radius: 16rpx;
  overflow: hidden;
}

.archive-item {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  border-right: 1px solid var(--es-line, rgba(255, 255, 255, 0.08));
}

.archive-item:last-child {
  border-right: none;
}

.archive-text {
  color: var(--es-txt-4, #7B8591);
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== L4 服务台层 ===== */
.svc-list {
  border-top: 1px solid var(--es-line, rgba(255, 255, 255, 0.05));
}

.svc-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid var(--es-line, rgba(255, 255, 255, 0.05));
}

.svc-item:last-child {
  border-bottom: none;
}

.svc-main {
  flex: 1;
  min-width: 0;
  padding-right: 14rpx;
}

.svc-name {
  color: var(--es-txt-4, #7B8591);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.svc-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 21rpx;
  line-height: 1.7;
}

/* ===== 合规声明 ===== */
.notice-card {
  border-style: dashed;
  border-color: var(--es-line, rgba(255, 255, 255, 0.12));
}

.notice-text {
  color: var(--es-txt-2, #AAB4BE);
  font-size: 21rpx;
  line-height: 1.75;
}

/* ===== L1.5 熵盾积分 + 控局者等级 ===== */
.es-points-card {
  border-color: rgba(0, 191, 255, 0.22);
  background: linear-gradient(180deg, rgba(0, 191, 255, 0.06) 0%, var(--es-card, #07111E) 100%);
}
.es-points-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.es-points-title {
  color: var(--es-white, #F4F7FA);
  font-size: 28rpx;
  font-weight: 700;
}
.es-points-level {
  color: var(--es-green, #00BFFF);
  font-size: 22rpx;
  font-weight: 600;
}
.es-points-grid {
  display: flex;
  gap: 12rpx;
}
.es-pitem {
  flex: 1;
  min-width: 0;
  padding: 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--es-line, rgba(255, 255, 255, 0.08));
  border-radius: 16rpx;
  background: var(--es-card-2, #0F1926);
}
.es-pk { color: var(--es-txt-2, #AAB4BE); font-size: 20rpx; }
.es-pv { margin-top: 6rpx; color: var(--es-txt-4, #7B8591); font-size: 26rpx; font-weight: 700; }
.es-rewards {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1px dashed var(--es-line, rgba(255, 255, 255, 0.12));
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}
.es-rewards-k { color: var(--es-txt-2, #AAB4BE); font-size: 21rpx; }
.es-reward {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 191, 255, 0.12);
  color: var(--es-green, #00BFFF);
  font-size: 20rpx;
  font-weight: 600;
}
