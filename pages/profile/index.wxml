<view class="page">

  <!-- L1 身份铭牌层 -->
  <view class="card badge-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">熵</view>
    </button>
    <view class="badge-main">
      <input
        class="nick-input"
        type="nickname"
        placeholder="点击设置昵称"
        placeholder-class="nick-ph"
        value="{{nickName}}"
        bindblur="onInputNickname"
        bindconfirm="onInputNickname"
      />
      <view class="badge-row">
        <text class="badge-level">{{levelText}}</text>
        <text class="badge-streak">连续打卡 {{streakDays}} 天</text>
      </view>
    </view>
    <view class="badge-setting" bindtap="goSettings">⚙</view>
  </view>

  <!-- L2 资产账本层 -->
  <view class="card ledger-card" bindtap="goMembership">
    <view class="ledger-head">
      <text class="ledger-title">资产账本</text>
      <text class="ledger-name">{{membershipName}}</text>
    </view>
    <view class="ledger-grid">
      <view class="ledger-item">
        <text class="li-label">会员到期</text>
        <text class="li-value">{{membershipExpireText}}</text>
      </view>
      <view class="ledger-item">
        <text class="li-label">剩余测算</text>
        <text class="li-value">{{taskRightsText}}</text>
      </view>
      <view class="ledger-item">
        <text class="li-label">训练进度</text>
        <text class="li-value">{{campProgressText}}</text>
      </view>
      <view class="ledger-item">
        <text class="li-label">段位</text>
        <text class="li-value">{{levelText}}</text>
      </view>
    </view>
    <view class="ledger-action">{{planActionText}} ›</view>
  </view>

  <!-- L3 战场层（V2.0 核心，高频） -->
  <view class="card battle-card">
    <view class="section-title">我在打的仗</view>

    <view class="battle-row" bindtap="goChallenge">
      <view class="battle-main">
        <text class="battle-name">我的挑战赛</text>
        <text class="battle-desc">{{challengeText}}</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>

    <view class="battle-row" bindtap="goWitness">
      <view class="battle-main">
        <text class="battle-name">我的见证人</text>
        <text class="battle-desc">{{witnessCount}} 人正在见证我</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>

    <view class="invite-box">
      <view class="invite-code-row">
        <text class="invite-code">{{myInviteCode || '待生成'}}</text>
        <view class="invite-copy" catchtap="copyInviteCode">复制</view>
      </view>
      <text class="invite-sub">邀请码 · 已邀请 {{invitedCountText}} 人</text>
    </view>

    <view class="archive-row">
      <view class="archive-item" bindtap="goTradeRecord">
        <text class="archive-text">交易记录</text>
      </view>
      <view class="archive-item" bindtap="goLongArchive">
        <text class="archive-text">长期档案</text>
      </view>
      <view class="archive-item" bindtap="goRiskReport">
        <text class="archive-text">我的报告</text>
      </view>
    </view>
  </view>

  <!-- L4 服务台层（低频全收纳） -->
  <view class="card service-card">
    <view class="section-title">服务台</view>
    <view class="svc-list">
      <view class="svc-item" bindtap="goSettings">
        <text class="svc-name">通知与订阅管理</text>
        <text class="nav-arrow">›</text>
      </view>
      <view class="svc-item" bindtap="goVisitBooking">
        <text class="svc-name">来访预约</text>
        <text class="nav-arrow">›</text>
      </view>
      <view class="svc-item" bindtap="onTapLatestVisitQuick" wx:if="{{latestVisit}}">
        <view class="svc-main">
          <text class="svc-name">最近来访</text>
          <text class="svc-desc">{{latestVisit.visitDateDisplay}} {{latestVisit.visitTimeRange || quickVisitTexts.timeFallback}}</text>
        </view>
        <text class="nav-arrow">›</text>
      </view>
      <view class="svc-item" bindtap="openServiceAgreement">
        <text class="svc-name">用户服务协议</text>
        <text class="nav-arrow">›</text>
      </view>
      <view class="svc-item" bindtap="openPrivacyContract">
        <text class="svc-name">隐私政策</text>
        <text class="nav-arrow">›</text>
      </view>
      <view class="svc-item" bindtap="tapAboutEntropy">
        <text class="svc-name">关于熵盾</text>
        <text class="nav-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card notice-card">
    <view class="notice-text">熵盾提供风险工具与规则支持，不构成任何投资建议。</view>
  </view>

</view>
