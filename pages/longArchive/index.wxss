page {
  background: #000000;
}

.la-page {
  min-height: 100vh;
  background: #000000;
  padding: 24rpx;
  box-sizing: border-box;
}

.la-summary-card,
.la-empty-card,
.la-card {
  background: #16181d;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(42, 255, 42, 0.14);
}

.la-summary-card {
  margin-bottom: 20rpx;
}

.la-summary-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.la-summary-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.la-summary-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8a8d93;
}

.la-summary-badge {
  min-width: 112rpx;
  text-align: center;
  padding: 10rpx 16rpx;
  height: fit-content;
  border-radius: 9999rpx;
  background: rgba(42, 255, 42, 0.12);
  color: #2aff2a;
  font-size: 24rpx;
  font-weight: 700;
}

.la-summary-meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #cfd6df;
}

.la-empty-card {
  margin-top: 20rpx;
}

.la-empty-title {
  display: block;
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
}

.la-empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8a8d93;
}

.la-empty-btn,
.la-bottom-btn {
  margin-top: 20rpx;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.la-empty-btn,
.la-bottom-btn {
  background: #2aff2a;
  color: #020305;
}

.la-bottom-btn-secondary {
  background: transparent;
  color: #2aff2a;
  border: 2rpx solid rgba(42, 255, 42, 0.6);
}

.la-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.la-card-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.la-top-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.la-code {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.la-type {
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  color: #2aff2a;
  background: rgba(42, 255, 42, 0.1);
}

.la-time {
  font-size: 20rpx;
  color: #8a8d93;
}

.la-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.la-cell {
  background: #1c1f25;
  border-radius: 18rpx;
  padding: 16rpx;
}

.la-label {
  display: block;
  font-size: 22rpx;
  color: #8a8d93;
}

.la-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #ffffff;
}

.la-strong {
  color: #2aff2a;
  font-weight: 700;
}

.la-bottom-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}
.la-ai-title {
  font-size: 28rpx;
  color: #2aff2a;
  font-weight: 700;
  margin-bottom: 16rpx;
}