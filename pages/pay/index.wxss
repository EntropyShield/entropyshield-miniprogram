page {
  background: var(--es-bg-deep, #050505);
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--es-bg-deep, #050505);
}

.hero-card,
.card {
  background: var(--es-green-surface, #0b1110);
  border: 2rpx solid #0f7a2d;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 0 16rpx rgba(36, 255, 90, 0.08);
}

.hero-title,
.section-title {
  color: var(--es-green-bright, #24ff5a);
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.hero-desc,
.plan-desc,
.summary-label,
.summary-value,
.plan-name,
.plan-rights,
.plan-disabled-tip {
  color: #e7f6ea;
}

.hero-desc,
.plan-desc,
.summary-value {
  font-size: 26rpx;
  line-height: 1.7;
}

.plan-card {
  border: 2rpx solid #184128;
  border-radius: 20rpx;
  padding: 22rpx;
  margin-top: 18rpx;
}

.plan-card-active {
  border-color: var(--es-green-bright, #24ff5a);
  box-shadow: 0 0 16rpx rgba(36, 255, 90, 0.12);
}

.plan-top,
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.plan-top {
  margin-bottom: 12rpx;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--es-green-bright, #24ff5a);
}

.plan-rights {
  font-size: 24rpx;
  color: #bfffd0;
}

.plan-disabled-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff9c9c;
}

.summary-row {
  margin-top: 16rpx;
  gap: 20rpx;
}

.summary-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #9bc7a6;
}

.summary-value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
}

.btn-primary,
.btn-ghost {
  margin-top: 24rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.btn-primary {
  background: var(--es-green-bright, #24ff5a);
  color: var(--es-green-surface, #041006);
}

.btn-ghost {
  background: transparent;
  color: var(--es-green-bright, #24ff5a);
  border: 2rpx solid var(--es-green-bright, #24ff5a);
}
