<view class="page">
  <view class="hero-card">
    <view class="hero-title">风控计算器支付页</view>
    <view class="hero-desc">{{topNotice}}</view>
  </view>

  <view class="card">
    <view class="section-title">官方收费口径</view>

    <block wx:for="{{plans}}" wx:key="key">
      <view class="plan-card {{selectedPlanKey === item.key ? 'plan-card-active' : ''}}" data-key="{{item.key}}" bindtap="onSelectPlan">
        <view class="plan-top">
          <view class="plan-name">{{item.title}}</view>
          <view class="plan-rights">{{item.rightsText}}</view>
        </view>
        <view class="plan-desc">{{item.desc}}</view>
        <view wx:if="{{type === 'advanced' && (item.key === 'times3' || item.key === 'month')}}" class="plan-disabled-tip">
          加强版不可用
        </view>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="section-title">当前选择</view>

    <view wx:if="{{upgradeMode}}" style="margin: 24rpx 0 0 0; padding: 24rpx; border: 1px solid var(--es-brand, #00BFFF); border-radius: 20rpx; background: rgba(0,191,255,0.06);">
      <view style="font-size: 30rpx; font-weight: 600; color: var(--es-brand, #00BFFF);">{{upgradeTitle}}</view>
      <view style="margin-top: 12rpx; font-size: 24rpx; line-height: 1.7; color: var(--es-txt-1, #F4F7FA);">{{upgradeContent}}</view>
    </view>

    <block wx:for="{{plans}}" wx:key="key">
      <view wx:if="{{selectedPlanKey === item.key}}" class="summary-row">
        <text class="summary-label">方案</text>
        <text class="summary-value">{{item.title}}</text>
      </view>
      <view wx:if="{{selectedPlanKey === item.key}}" class="summary-row">
        <text class="summary-label">权限</text>
        <text class="summary-value">{{item.rights}}</text>
      </view>
      <view wx:if="{{selectedPlanKey === item.key}}" class="summary-row">
        <text class="summary-label">说明</text>
        <text class="summary-value">{{item.desc}}</text>
      </view>
    </block>

    <button wx:if="{{!upgradeMode}}" class="btn-primary" loading="{{paying}}" bindtap="onPayTap">
      {{paying ? '支付处理中...' : '立即购买'}}
    </button>

    <button wx:else class="btn-primary" loading="{{paying}}" bindtap="onPayTap">
      {{paying ? '支付处理中...' : upgradeButtonText}}
    </button>

    <button class="btn-ghost" bindtap="goBack">返回</button>
  </view>
</view>

