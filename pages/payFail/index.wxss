page {
  background: var(--es-bg-deep, #010407);
}
.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--es-bg-deep, #010407);
}
.card {
  background: var(--es-green-surface, #04263A);
  border: 2rpx solid var(--es-line, #4B5663);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 0 16rpx rgba(36, 255, 90, 0.08);
}
.title {
  color: var(--es-green-bright, #00E8FF);
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.desc {
  color: var(--es-txt-2, #AAB4BE);
  font-size: 28rpx;
  line-height: 1.7;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}
.label {
  width: 120rpx;
  font-size: 26rpx;
  color: var(--es-txt-2, #AAB4BE);
}
.value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--es-txt-2, #AAB4BE);
  line-height: 1.7;
}
.btn-primary,
.btn-ghost {
  margin-top: 24rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.btn-primary {
  background: var(--es-green-bright, #00E8FF);
  color: var(--es-green-surface, #04263A);
}
.btn-ghost {
  background: transparent;
  color: var(--es-green-bright, #00E8FF);
  border: 2rpx solid var(--es-green-bright, #00E8FF);
}