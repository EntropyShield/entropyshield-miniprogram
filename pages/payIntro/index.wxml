<view class="page">
  <view class="card">
    <view class="title">风控计算器收费说明</view>

    <view wx:if="{{levelName}}" class="row">
      <text class="label">当前入口</text>
      <text class="value">{{levelName}}</text>
    </view>

    <view class="row">
      <text class="label">产品</text>
      <text class="value">风控计算器</text>
    </view>

    <view class="row">
      <text class="label">终身会员</text>
      <text class="value">仅限你自己的 ID 使用</text>
    </view>
  </view>

  <view class="card">
    <view class="title">官方收费口径</view>

    <block wx:for="{{feeList}}" wx:key="key">
      <view class="row">
        <text class="label">{{item.name}}</text>
        <text class="value">{{item.rights}}</text>
      </view>
      <view class="row">
        <text class="label">说明</text>
        <text class="value">{{item.desc}}</text>
      </view>
    </block>
  </view>

  <button class="btn" bindtap="goBack">返回</button>
</view>