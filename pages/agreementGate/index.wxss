/* A1 合规首启闸门样式 —— 深色 + 电光绿，使用 page{} 设计令牌并带 fallback */
.gate-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 14, 20, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 48rpx;
  box-sizing: border-box;
}

.gate-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--es-surface, #141A22);
  border: 1rpx solid var(--es-border, #1F2730);
  border-radius: 28rpx;
  padding: 56rpx 44rpx 44rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.gate-brand {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.gate-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--es-green, #00E5A0), #00B37A);
  color: var(--es-on-green, #04140E);
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.gate-brand-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--es-text, #E6EDF3);
  letter-spacing: 1rpx;
}

.gate-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--es-text, #E6EDF3);
  margin-bottom: 16rpx;
}

.gate-desc {
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--es-sub, #9AA4B2);
  margin-bottom: 32rpx;
}

.gate-links {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 36rpx;
}

.gate-link {
  font-size: 28rpx;
  color: var(--es-green, #00E5A0);
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(0, 229, 160, 0.08);
  border: 1rpx solid rgba(0, 229, 160, 0.25);
}

.gate-agree {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--es-panel, #10151C);
}

.gate-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--es-border, #2A3340);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.gate-checkbox.checked {
  background: var(--es-green, #00E5A0);
  border-color: var(--es-green, #00E5A0);
}

.gate-check {
  color: var(--es-on-green, #04140E);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.gate-agree-text {
  font-size: 28rpx;
  color: var(--es-text, #E6EDF3);
}

.gate-actions {
  display: flex;
  gap: 20rpx;
}

.gate-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
  border: none;
}

.gate-btn::after {
  border: none;
}

.gate-btn-ghost {
  background: transparent;
  color: var(--es-sub, #9AA4B2);
  border: 1rpx solid var(--es-border, #2A3340);
}

.gate-btn-primary {
  background: linear-gradient(135deg, var(--es-green, #00E5A0), #00B37A);
  color: var(--es-on-green, #04140E);
}

.gate-btn-primary.disabled {
  background: var(--es-border, #2A3340);
  color: #6B7682;
}

.gate-foot {
  font-size: 22rpx;
  color: var(--es-sub, #6B7682);
  text-align: center;
  margin-top: 28rpx;
  line-height: 34rpx;
}
