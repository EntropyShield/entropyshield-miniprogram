/* A1 合规首启闸门样式 —— 深色 + 电光绿，使用 page{} 设计令牌并带 fallback */
.gate-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 14, 20, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 48rpx;
  box-sizing: border-box;
}

.gate-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--es-surface, #0F1926);
  border: 1rpx solid var(--es-border, #4B5663);
  border-radius: 28rpx;
  padding: 56rpx 44rpx 44rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
}

.gate-brand {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.gate-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--es-green, #00BFFF), #006CFF);
  color: var(--es-on-green, #03060C);
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.gate-brand-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--es-text, #F4F7FA);
  letter-spacing: 1rpx;
}

.gate-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--es-text, #F4F7FA);
  margin-bottom: 16rpx;
}

.gate-desc {
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--es-sub, #AAB4BE);
  margin-bottom: 32rpx;
}

.gate-links {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 36rpx;
}

.gate-link {
  font-size: 28rpx;
  color: var(--es-green, #00BFFF);
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(0, 191, 255, 0.08);
  border: 1rpx solid rgba(0, 191, 255, 0.25);
}

.gate-agree {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--es-panel, #0F1926);
}

.gate-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--es-border, #4B5663);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.gate-checkbox.checked {
  background: var(--es-green, #00BFFF);
  border-color: var(--es-green, #00BFFF);
}

.gate-check {
  color: var(--es-on-green, #03060C);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.gate-agree-text {
  font-size: 28rpx;
  color: var(--es-text, #F4F7FA);
}

.gate-actions {
  display: flex;
  gap: 20rpx;
}

.gate-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
  border: none;
}

.gate-btn::after {
  border: none;
}

.gate-btn-ghost {
  background: transparent;
  color: var(--es-sub, #AAB4BE);
  border: 1rpx solid var(--es-border, #4B5663);
}

.gate-btn-primary {
  background: linear-gradient(135deg, var(--es-green, #00BFFF), #006CFF);
  color: var(--es-on-green, #03060C);
}

.gate-btn-primary.disabled {
  background: var(--es-elevated, #151F2C);
  color: var(--es-txt-3, #8E98A3);
}

.gate-foot {
  font-size: 22rpx;
  color: var(--es-sub, #8E98A3);
  text-align: center;
  margin-top: 28rpx;
  line-height: 34rpx;
}
