<view class="page">
  <view class="card">
    <view class="title">{{statusTitle}}</view>
    <view class="desc">{{statusDesc}}</view>
  </view>

  <view class="card">
    <view class="row">
      <text class="label">方案</text>
      <text class="value">{{title}}</text>
    </view>
    <view class="row">
      <text class="label">权限</text>
      <text class="value">{{rights}}</text>
    </view>
    <view class="row">
      <text class="label">说明</text>
      <text class="value">{{desc}}</text>
    </view>
    <view wx:if="{{amountText}}" class="row">
      <text class="label">支付金额</text>
      <text class="value">￥{{amountText}}</text>
    </view>
  </view>

  <button class="btn-primary" bindtap="goCalc" disabled="{{!confirmed}}">{{confirmed ? "去使用风控计算器" : "权益确认中"}}</button>
  <button class="btn-ghost" bindtap="goHome">返回首页</button>
</view>