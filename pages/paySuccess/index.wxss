page {
  background: #050505;
}
.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #050505;
}
.card {
  background: #0b1110;
  border: 2rpx solid #0f7a2d;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 0 16rpx rgba(36, 255, 90, 0.08);
}
.title {
  color: #24ff5a;
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.desc {
  color: #e7f6ea;
  font-size: 28rpx;
  line-height: 1.7;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 18rpx;
}
.label {
  width: 150rpx;
  font-size: 26rpx;
  color: #9bc7a6;
}
.value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #e7f6ea;
  line-height: 1.7;
}
.btn-primary,
.btn-ghost {
  margin-top: 24rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}
.btn-primary {
  background: #24ff5a;
  color: #041006;
}
.btn-ghost {
  background: transparent;
  color: #24ff5a;
  border: 2rpx solid #24ff5a;
}