.page {
  min-height: 100vh;
  background: var(--es-bg-deep, #010407);
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--es-card-2, #0F1926);
  border-radius: 24rpx;
  padding: 28rpx 24rpx 40rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--es-white, #F4F7FA);
}

.update-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.section {
  margin-top: 28rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--es-green, #00BFFF);
  margin-bottom: 10rpx;
}

.paragraph {
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--es-txt-4, #7B8591);
}