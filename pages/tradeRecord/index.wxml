<view class="la-page">
  <view class="la-summary-card">
    <view class="la-summary-top">
      <view>
        <text class="la-summary-title">我的交易记录</text>
        <text class="la-summary-sub">统一查看交易记录、止损价格、最大风险和目标价格。</text>
      </view>
      <view class="la-summary-badge">{{totalCount}} 条</view>
    </view>
    <view class="la-summary-meta" wx:if="{{latestTime}}">最近记录：{{latestTime}}</view>
  </view>

  <view wx:if="{{!list.length}}" class="la-empty-card">
    <text class="la-empty-title">还没有交易记录</text>
    <text class="la-empty-desc">先生成方案并进入主链，记录才会沉淀到这里。</text>
    <view class="la-empty-btn" bindtap="goRiskCalculator">去风控计算器</view>
  </view>

  <view wx:else class="la-list">
    <block wx:for="{{list}}" wx:key="__activeKey">
      <view class="la-card">
        <view class="la-card-top">
          <view class="la-top-left">
            <text class="la-code">{{item.code || '未填写标的'}}</text>
            <text class="la-type">{{item.planTypeText || '当前方案'}}</text>
          </view>
          <text class="la-time">{{item.timeText}}</text>
        </view>

        <view class="la-grid">
          <view class="la-cell">
            <text class="la-label">来源</text>
            <text class="la-value">{{item.source}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">版本</text>
            <text class="la-value">{{item.entryVersion}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">首次价格</text>
            <text class="la-value">{{item.firstPrice || '—'}} 元</text>
          </view>
          <view class="la-cell">
            <text class="la-label">止损价格</text>
            <text class="la-value">{{item.stopLossPrice || '—'}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">最大风险</text>
            <text class="la-value la-strong">{{item.maxLossAmount || '—'}} 元</text>
          </view>
          <view class="la-cell">
            <text class="la-label">目标价格</text>
            <text class="la-value la-strong">{{item.targetPrice || '—'}} 元</text>
          </view>
        </view>
      </view>
    </block>

    <view class="la-bottom-actions">
      <view class="la-bottom-btn la-bottom-btn-secondary" bindtap="goRiskReport">查看最新风控报告</view>
      <view class="la-bottom-btn la-bottom-btn-secondary" bindtap="goLongArchive">查看长期档案</view>
      <view class="la-bottom-btn la-bottom-btn-secondary" bindtap="goMainchainOverview">查看主链总览</view>
      <view class="la-bottom-btn" bindtap="goRiskCalculator">继续生成方案</view>
    </view>
  </view>
</view>