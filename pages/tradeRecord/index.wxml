<view class="la-page">
  <view class="la-summary-card">
    <view class="la-summary-top">
      <view>
        <text class="la-summary-title">我的交易记录</text>
        <text class="la-summary-sub">统一查看交易记录、止损价格、最大风险和目标价格。</text>
      </view>
      <view class="la-summary-badge">{{totalCount}} 条</view>
    </view>
    <view class="la-summary-meta" wx:if="{{latestTime}}">最近记录：{{latestTime}}</view>
  </view>

  <view wx:if="{{!list.length}}" class="la-empty-card">
    <text class="la-empty-title">还没有交易记录</text>
    <text class="la-empty-desc">先生成方案并进入主链，记录才会沉淀到这里。</text>
    <view class="la-empty-btn" bindtap="goRiskCalculator">去风控计算器</view>
  </view>

  <view wx:else class="la-list">
    <block wx:for="{{list}}" wx:key="__activeKey">
      <view class="la-card">
        <view class="la-card-top">
          <view class="la-top-left">
            <text class="la-code">{{item.code || '未填写标的'}}</text>
            <text class="la-type">{{item.planTypeText || '当前方案'}}</text>
          </view>
          <text class="la-time">{{item.timeText}}</text>
        </view>

        <view class="la-grid">
          <view class="la-cell">
            <text class="la-label">来源</text>
            <text class="la-value">{{item.source}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">版本</text>
            <text class="la-value">{{item.entryVersion}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">首次价格</text>
            <text class="la-value">{{item.firstPrice || '—'}} 元</text>
          </view>
          <view class="la-cell">
            <text class="la-label">止损价格</text>
            <text class="la-value">{{item.stopLossPrice || '—'}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">最大风险</text>
            <text class="la-value la-strong">{{item.maxLossAmount || '—'}} 元</text>
          </view>
          <view class="la-cell">
            <text class="la-label">目标价格</text>
            <text class="la-value la-strong">{{item.targetPrice || '—'}} 元</text>
          </view>
          <view class="la-cell">
            <text class="la-label">执行状态</text>
            <text class="la-value">{{item.executionStatusText}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">SRR评分</text>
            <text class="la-value">{{item.srrScoreText}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">偏差标签</text>
            <text class="la-value">{{item.deviationTagsText}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">组标签</text>
            <text class="la-value">{{item.groupTag || '无'}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">阶段标签</text>
            <text class="la-value">{{item.stageTag || '无'}}</text>
          </view>
          <view class="la-cell">
            <text class="la-label">档案标签</text>
            <text class="la-value">{{item.archiveTagsText}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="la-card" wx:if="{{currentItem}}">
      <view class="la-summary-title" style="font-size: 30rpx;">当前记录评分与标签</view>
      <view class="la-summary-sub" style="margin-top: 8rpx;">当前回写对象：{{currentItem.code || '未填写标的'}} / {{currentItem.planTypeText}}</view>

      <view style="margin-top: 20rpx;">
        <text class="la-label">SRR评分（0-100）</text>
        <input value="{{srrScoreInput}}" data-field="srrScoreInput" bindinput="onFormInput" type="digit" placeholder="例如 78" style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:#fff;" />
      </view>

      <view style="margin-top: 20rpx;">
        <text class="la-label">执行状态</text>
        <picker mode="selector" range="{{executionOptionLabels}}" value="{{executionStatusIndex}}" bindchange="onExecutionChange">
          <view style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:#fff;">
            {{executionStatusText}}
          </view>
        </picker>
      </view>

      <view style="margin-top: 20rpx;">
        <text class="la-label">偏差标签</text>
        <textarea value="{{deviationTagsInput}}" data-field="deviationTagsInput" bindinput="onFormInput" auto-height placeholder="用顿号或逗号分隔，例如：拖延止损、抢跑加仓" style="margin-top:12rpx;min-height:120rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:#fff;"></textarea>
      </view>

      <view style="margin-top: 20rpx;">
        <text class="la-label">组标签</text>
        <input value="{{groupTagInput}}" data-field="groupTagInput" bindinput="onFormInput" placeholder="例如：第1组" style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:#fff;" />
      </view>

      <view style="margin-top: 20rpx;">
        <text class="la-label">阶段标签</text>
        <input value="{{stageTagInput}}" data-field="stageTagInput" bindinput="onFormInput" placeholder="例如：阶段A" style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:#fff;" />
      </view>

      <view style="margin-top: 20rpx;">
        <text class="la-label">档案标签</text>
        <textarea value="{{archiveTagsInput}}" data-field="archiveTagsInput" bindinput="onFormInput" auto-height placeholder="用顿号或逗号分隔，例如：执行稳定、止损合规" style="margin-top:12rpx;min-height:120rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:#fff;"></textarea>
      </view>

      <view class="la-bottom-btn" bindtap="saveEvaluation" style="margin-top: 24rpx; opacity: {{savingEvaluation ? 0.6 : 1}};">保存评分与标签</view>
    </view>

    <view class="la-bottom-actions">
      <view class="la-bottom-btn la-bottom-btn-secondary" bindtap="goRiskReport">查看最新风控报告</view>
      <view class="la-bottom-btn la-bottom-btn-secondary" bindtap="goLongArchive">查看长期档案</view>
      <view class="la-bottom-btn la-bottom-btn-secondary" bindtap="goMainchainOverview">查看主链总览</view>
      <view class="la-bottom-btn" bindtap="goRiskCalculator">继续生成方案</view>
    </view>
  </view>
</view>