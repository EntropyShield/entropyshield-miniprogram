/* pages/index/index.wxss · [V2.0-B2] 仪表盘样式（全用设计令牌，带 fallback） */
.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--es-bg, #03060C);
  color: var(--es-txt-1, #F4F7FA);
}

/* 顶部栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-2, 16rpx);
}
.brand { display: flex; align-items: center; gap: 14rpx; }
.brand-logo {
  width: 72rpx; height: 72rpx;
  border-radius: 18rpx;
  background: var(--es-bg, #03060C);
  flex-shrink: 0;
}
.brand-name { font-size: var(--fs-md, 32rpx); font-weight: 600; }
.brand-sub { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-2, #AAB4BE); margin-top: 2rpx; }
.member-chip {
  display: flex; flex-direction: column; align-items: flex-end;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--es-green-bg, rgba(0, 191, 255, .12));
  border: 1rpx solid rgba(0, 191, 255, .3);
}
.member-label { font-size: var(--fs-xs, 20rpx); color: var(--es-green, #00BFFF); font-weight: 600; }
.member-exp { font-size: 18rpx; color: var(--es-txt-3, #8E98A3); margin-top: 2rpx; }
/* [2026-09-10] 首页露出剩余测算次数（homeTaskRightsText 此前已计算但未渲染） */
.member-quota { font-size: 18rpx; color: var(--es-green, #00BFFF); margin-top: 2rpx; font-weight: 500; }

/* 风险温度大卡 */
.temp-card { position: relative; overflow: hidden; }
/* [ESOS-01] 核心口号（冻结标准表达）· 温度卡顶部品牌条 */
.temp-brand { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-3, #8E98A3); letter-spacing: 1rpx; margin-bottom: 12rpx; }
.temp-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--sp-2, 16rpx); }
.temp-title { font-size: var(--fs-md, 32rpx); font-weight: 600; }
.temp-upd { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-3, #8E98A3); }
.temp-body { display: flex; align-items: center; gap: 28rpx; }
.gauge { position: relative; width: 180rpx; height: 180rpx; flex-shrink: 0; }
.gauge-svg { width: 180rpx; height: 180rpx; transform: rotate(-90deg); }
.gauge-bg { fill: none; stroke: var(--es-line, #4B5663); stroke-width: 9; }
.gauge-fg { fill: none; stroke: var(--es-amber, #FFB020); stroke-width: 9; stroke-linecap: round; transition: stroke-dasharray .4s ease; }
.gauge-num { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.gauge-score { font-size: 52rpx; font-weight: 700; line-height: 1; }
.gauge-unit { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-3, #8E98A3); margin-top: 4rpx; }
.temp-info { flex: 1; }
.level-tag {
  display: inline-block; font-size: var(--fs-xs, 20rpx); font-weight: 600;
  padding: 4rpx 14rpx; border-radius: 8rpx;
  border: 1rpx solid var(--es-amber, #FFB020); color: var(--es-amber, #FFB020);
  margin-bottom: 10rpx;
}
.verdict { font-size: var(--fs-md, 32rpx); font-weight: 700; }
.verdict-sub { font-size: var(--fs-sm, 24rpx); color: var(--es-txt-2, #AAB4BE); line-height: 1.5; margin-top: 4rpx; }
/* [2026-09-09] 上一交易日收盘对比行：与今日实时值并排，供用户判断温度走向 */
.temp-prev { font-size: var(--fs-xs, 22rpx); color: var(--es-txt-3, #7A8794); line-height: 1.5; margin-top: 8rpx; }
.share-temp {
  margin-top: var(--sp-3, 24rpx);
  width: 100%; height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-base, 28rpx); font-weight: 600;
  color: var(--es-green, #00BFFF);
  background: var(--es-green-bg, rgba(0, 191, 255, .1));
  border: 1rpx solid rgba(0, 191, 255, .4);
  border-radius: var(--radius-sm, 12rpx);
}
.share-temp:active { opacity: .7; }
/* [2026-09-09] 温度卡两个动作并排：转发小程序卡片 / 生成图片存相册 */
.temp-actions { display: flex; gap: var(--sp-2, 16rpx); }
.temp-actions .share-temp { flex: 1; }
.share-temp-ghost {
  color: var(--es-txt-1, #F4F7FA);
  background: var(--es-elevated, #151F2C);
  border: 1rpx solid var(--es-line, #4B5663);
}
/* [2026-09-09] 每日温度提醒开关（服务号推送，默认关，需用户主动开启） */
.oa-push {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: var(--sp-3, 24rpx);
  padding-top: var(--sp-3, 24rpx);
  border-top: 1rpx solid rgba(75, 86, 99, .4);
}
.oa-push-main { display: flex; flex-direction: column; }
.oa-push-k { font-size: var(--fs-base, 28rpx); font-weight: 600; color: var(--es-txt-1, #F4F7FA); }
.oa-push-s { font-size: var(--fs-xs, 22rpx); color: var(--es-txt-3, #7A8794); margin-top: 4rpx; }
.oa-follow {
  margin-top: var(--sp-2, 16rpx);
  width: 100%; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-sm, 24rpx); font-weight: 600;
  color: var(--es-amber, #FFB020);
  background: rgba(255, 176, 32, .1);
  border: 1rpx solid rgba(255, 176, 32, .4);
  border-radius: var(--radius-sm, 12rpx);
}

/* 打卡条 */
.checkin { display: flex; align-items: center; justify-content: space-between; }
.checkin-left { display: flex; flex-direction: column; align-items: center; min-width: 120rpx; }
.checkin-streak { font-size: 56rpx; font-weight: 700; color: var(--es-green, #00BFFF); line-height: 1; }
.checkin-label { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-2, #AAB4BE); margin-top: 6rpx; }
.checkin-right { flex: 1; margin-left: var(--sp-3, 24rpx); }
.checkin-sub { font-size: var(--fs-sm, 24rpx); color: var(--es-txt-2, #AAB4BE); margin-bottom: 14rpx; }
.checkin-btn {
  height: 72rpx; border-radius: var(--radius-sm, 12rpx);
  background: linear-gradient(135deg, var(--es-green, #00BFFF), var(--es-green-deep, #006CFF));
  color: var(--es-on-green, #03060C); font-size: var(--fs-base, 28rpx); font-weight: 600;
}
.checkin-btn.is-done { background: var(--es-card, #07111E); color: var(--es-txt-2, #AAB4BE); border: 1rpx solid var(--es-line, #4B5663); }
.checkin-btn[disabled] { opacity: 1; }

/* 打卡成功分享战绩按钮（激励：分享得积分） */
.es-share-btn {
  margin-top: 14rpx;
  height: 64rpx;
  border-radius: var(--radius-sm, 12rpx);
  background: transparent;
  border: 1rpx solid var(--es-green, #00BFFF);
  color: var(--es-green, #00BFFF);
  font-size: var(--fs-sm, 24rpx);
  font-weight: 600;
  line-height: 64rpx;
}
.es-share-btn::after { border: none; }

/* 四宫格 */
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2, 16rpx); margin-bottom: var(--sp-2, 16rpx); }
.tile { padding: var(--sp-2, 16rpx); }
.tile-k { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-2, #AAB4BE); }
.tile-v { font-size: var(--fs-xl, 44rpx); font-weight: 700; display: flex; align-items: baseline; gap: 6rpx; margin: 8rpx 0 4rpx; }
.tile-vs { font-size: var(--fs-xs, 20rpx); font-weight: 400; color: var(--es-txt-2, #AAB4BE); }
.tile-m { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-3, #8E98A3); }

/* 区块 */
.section { margin-bottom: var(--sp-2, 16rpx); }
.sec-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.sec-title { font-size: var(--fs-md, 32rpx); font-weight: 600; }
.sec-more { font-size: var(--fs-sm, 24rpx); color: var(--es-green, #00BFFF); }

/* 持仓诊断列表 */
.item-l { display: flex; align-items: center; gap: 18rpx; }
.item-ico {
  width: 60rpx; height: 60rpx; border-radius: 14rpx;
  background: var(--es-elevated, #151F2C); border: 1rpx solid var(--es-line, #4B5663);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-base, 28rpx); color: var(--es-green, #00BFFF);
}
.item-name { font-size: var(--fs-base, 28rpx); font-weight: 500; }
.item-d { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-3, #8E98A3); margin-top: 4rpx; }
.empty { padding: var(--sp-3, 24rpx); display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.empty-txt { font-size: var(--fs-sm, 24rpx); color: var(--es-txt-3, #8E98A3); }
.empty-cta { font-size: var(--fs-sm, 24rpx); color: var(--es-green, #00BFFF); }

/* 测试卡 */
.test-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2, 16rpx); }
.test-card { padding: var(--sp-2, 16rpx); }
.test-title { font-size: var(--fs-base, 28rpx); font-weight: 600; }
.test-desc { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-2, #AAB4BE); line-height: 1.4; margin: 6rpx 0 10rpx; }
.test-go { font-size: var(--fs-xs, 20rpx); color: var(--es-green, #00BFFF); font-weight: 600; }

/* 箴言 */
.quote { display: flex; align-items: flex-start; gap: 10rpx; }
.quote-mark { font-size: 48rpx; color: var(--es-green, #00BFFF); line-height: 1; }
.quote-txt { flex: 1; font-size: var(--fs-base, 28rpx); color: var(--es-txt-1, #F4F7FA); line-height: 1.6; }

/* CTA */
.cta { margin: var(--sp-2, 16rpx) 0; }
.cta-note { text-align: center; font-size: 18rpx; color: var(--es-txt-3, #8E98A3); margin-top: 12rpx; }

/* 更多入口 */
.more-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 4rpx; border-bottom: 1rpx solid var(--es-line, #4B5663);
  font-size: var(--fs-base, 28rpx); color: var(--es-txt-1, #F4F7FA);
}
.more-item:last-child { border-bottom: none; }
.more-arrow { color: var(--es-txt-3, #8E98A3); }

/* 责任边界 */
.notice { padding: var(--sp-2, 16rpx) 4rpx 0; }
.notice-txt { font-size: 18rpx; color: var(--es-txt-3, #8E98A3); line-height: 1.6; }

/* ③ 活动入口 Banner（读服务器开关显隐） */
.act-banner { margin-bottom: var(--sp-2, 16rpx); }
.act-card {
  position: relative;
  display: flex; align-items: center; gap: 18rpx;
  padding: var(--sp-2, 18rpx) 20rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}
.act-card:active { opacity: .75; }
.act-tag {
  flex-shrink: 0;
  font-size: var(--fs-xs, 20rpx); font-weight: 600;
  color: var(--es-amber, #FFB020);
  background: rgba(255, 176, 32, .12);
  border: 1rpx solid rgba(255, 176, 32, .35);
  padding: 6rpx 14rpx; border-radius: 8rpx;
}
.act-body { flex: 1; min-width: 0; }
.act-title { font-size: var(--fs-base, 28rpx); font-weight: 600; }
.act-sub { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-2, #AAB4BE); margin-top: 4rpx; }
.act-reward { font-size: var(--fs-xs, 20rpx); color: var(--es-green, #00BFFF); margin-top: 6rpx; }
.act-go { flex-shrink: 0; font-size: var(--fs-sm, 24rpx); color: var(--es-green, #00BFFF); font-weight: 600; }
