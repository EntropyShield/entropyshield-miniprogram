<!-- pages/index/index.wxml · [V2.0-B2] 每日风控仪表盘 -->
<view class="page">

  <!-- 顶部品牌 + 会员状态 -->
  <view class="topbar">
    <view class="brand">
      <canvas type="2d" id="entropyLogo" class="brand-logo"></canvas>
      <view class="brand-txt">
        <view class="brand-name">熵盾</view>
        <view class="brand-sub">每日风控仪表盘</view>
      </view>
    </view>
    <view class="member-chip" bindtap="goMembership">
      <text class="member-label">{{homeMembershipLabel}}</text>
      <text class="member-exp">{{homeMembershipExpireText}}</text>
    </view>
  </view>

  <!-- 今日市场风险温度大卡（B1/B2） -->
  <view class="temp-card es-card">
    <view class="temp-head">
      <text class="temp-title">今日市场风险温度</text>
      <text class="temp-upd">{{riskTemp.updTime ? riskTemp.updTime + ' 更新' : '开盘前更新中'}}</text>
    </view>
    <view class="temp-body">
      <view class="gauge">
        <svg class="gauge-svg" viewBox="0 0 110 110">
          <circle cx="55" cy="55" r="46" class="gauge-bg"/>
          <circle cx="55" cy="55" r="46" class="gauge-fg" style="stroke-dasharray:{{riskTemp.ringDash}} 289;stroke:{{riskTemp.color}};"/>
        </svg>
        <view class="gauge-num">
          <text class="gauge-score" style="color:{{riskTemp.color}}">{{riskTemp.ready ? riskTemp.score : '--'}}</text>
          <text class="gauge-unit">/100</text>
        </view>
      </view>
      <view class="temp-info">
        <view class="level-tag" style="color:{{riskTemp.color}};border-color:{{riskTemp.color}}">{{riskTemp.level}}</view>
        <view class="verdict">{{riskTemp.verdict}}</view>
        <view class="verdict-sub">{{riskTemp.verdictSub}}</view>
      </view>
    </view>
    <button class="share-temp" open-type="share">分享今日温度卡</button>
  </view>

  <!-- 每日打卡条（B3） -->
  <view class="checkin es-card">
    <view class="checkin-left">
      <text class="checkin-streak">{{checkIn.streak}}</text>
      <text class="checkin-label">连续打卡天</text>
    </view>
    <view class="checkin-right">
      <view class="checkin-sub">每天开盘前看一眼，规则就养成了</view>
      <button class="checkin-btn {{checkIn.todayDone ? 'is-done' : ''}}" bindtap="doCheckIn" disabled="{{checkIn.todayDone}}">
        {{checkIn.todayDone ? '今日已打卡 ✓' : '立即打卡'}}
      </button>
    </view>
  </view>

  <!-- 四宫格 -->
  <view class="grid">
    <view class="tile es-card" bindtap="goRiskReport">
      <text class="tile-k">风险温度</text>
      <text class="tile-v" style="color:{{riskTemp.color}}">{{riskTemp.ready ? riskTemp.score : '--'}} <text class="tile-vs">{{riskTemp.level}}</text></text>
      <text class="tile-m">每日更新</text>
    </view>
    <view class="tile es-card" bindtap="goMainchainOverview">
      <text class="tile-k">监控池信号</text>
      <text class="tile-v" style="color:var(--es-green, #00E5A0)">{{monitorCount}} <text class="tile-vs">个标的</text></text>
      <text class="tile-m">进入结构区间</text>
    </view>
    <view class="tile es-card" bindtap="goTradeRecord">
      <text class="tile-k">持仓诊断</text>
      <text class="tile-v" style="color:var(--es-amber, #FFB020)">{{holdings.length}} <text class="tile-vs">需关注</text></text>
      <text class="tile-m">距止损边界</text>
    </view>
    <view class="tile es-card" bindtap="goCamp">
      <text class="tile-k">连续打卡</text>
      <text class="tile-v" style="color:var(--es-green, #00E5A0)">{{checkIn.streak}} <text class="tile-vs">天</text></text>
      <text class="tile-m">纪律在养成</text>
    </view>
  </view>

  <!-- 持仓诊断（B4） -->
  <view class="section">
    <view class="sec-head">
      <text class="sec-title">我的持仓诊断</text>
      <text class="sec-more" bindtap="goTradeRecord">查看全部</text>
    </view>
    <view class="es-list">
      <block wx:if="{{holdings.length}}">
        <view class="es-item" wx:for="{{holdings}}" wx:key="name">
          <view class="item-l">
            <view class="item-ico">{{item.initial}}</view>
            <view>
              <view class="item-name">{{item.name}}</view>
              <view class="item-d">止损价 {{item.stop}}</view>
            </view>
          </view>
          <text class="es-tag">{{item.tag}}</text>
        </view>
      </block>
      <view class="empty" wx:else>
        <text class="empty-txt">{{holdingsHint}}</text>
        <text class="empty-cta" bindtap="goTradeRecord">去录入持仓 →</text>
      </view>
    </view>
  </view>

  <!-- 风险体检测试（C1/C3） -->
  <view class="section">
    <view class="sec-head">
      <text class="sec-title">风险体检测试</text>
      <text class="sec-more" bindtap="goTest" data-key="loss" data-path="/pkgTest/testLossPersonality/index">全部</text>
    </view>
    <view class="test-grid">
      <view class="test-card es-card" wx:for="{{riskTests}}" wx:key="key" bindtap="goTest" data-key="{{item.key}}" data-path="{{item.path}}">
        <view class="test-title">{{item.title}}</view>
        <view class="test-desc">{{item.desc}}</view>
        <text class="test-go">去测 ›</text>
      </view>
    </view>
  </view>

  <!-- 每日箴言 -->
  <view class="quote es-card">
    <text class="quote-mark">“</text>
    <text class="quote-txt">{{dailyQuote}}</text>
  </view>

  <!-- 核心动作 -->
  <view class="cta">
    <button class="es-btn" bindtap="goCalc" data-source="dash">一键风控计算</button>
    <view class="cta-note">计算器降级为看板里的一个动作 · 为看数据而来，顺手就用了</view>
  </view>

  <!-- 更多入口 -->
  <view class="more es-card">
    <view class="more-item" bindtap="goTradeRecord"><text>我的交易记录</text><text class="more-arrow">›</text></view>
    <view class="more-item" bindtap="goRiskReport"><text>风控报告</text><text class="more-arrow">›</text></view>
    <view class="more-item" bindtap="goLongArchive"><text>长期档案</text><text class="more-arrow">›</text></view>
    <view class="more-item" bindtap="goMainchainOverview"><text>主链总览</text><text class="more-arrow">›</text></view>
    <view class="more-item" bindtap="goCamp"><text>7 天风控训练营</text><text class="more-arrow">›</text></view>
    <view class="more-item" bindtap="goController"><text>进入风控工作台</text><text class="more-arrow">›</text></view>
  </view>

  <!-- 责任边界（A3 全局免责，首页常驻） -->
  <view class="notice">
    <text class="notice-txt">熵盾提供风险信息、规则工具与风险管理支持。相关结果不构成投资建议，不替代用户独立判断与自主决策。</text>
  </view>

</view>
