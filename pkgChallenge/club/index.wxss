@import "../../app.wxss";

.page {
  min-height: 100vh;
  background: #0f1620;
  padding: 16px;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
}
.hero-title {
  font-size: 22px;
  font-weight: 700;
  color: #e8edf4;
}
.hero-sub {
  margin-top: 4px;
  font-size: 13px;
  color: #8a96a8;
}

.card {
  background: #18222f;
  border: 1px solid #243042;
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 16px;
}

.member {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.member.on {
  border-color: #c79a4b;
  background: linear-gradient(135deg, #1c2533, #20283a);
}
.member-row {
  display: flex;
  flex-direction: column;
}
.member-name {
  font-size: 18px;
  font-weight: 700;
  color: #e8edf4;
}
.member-expire {
  margin-top: 4px;
  font-size: 12px;
  color: #8a96a8;
}
.member-rights {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.rights-num {
  font-size: 24px;
  font-weight: 700;
  color: #4ea1ff;
}
.rights-label {
  font-size: 11px;
  color: #8a96a8;
}

.section {
  margin-bottom: 16px;
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #cdd6e2;
  margin-bottom: 10px;
}

.benefit {
  background: #18222f;
  border: 1px solid #243042;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
}
.benefit-name {
  font-size: 14px;
  font-weight: 600;
  color: #e8edf4;
}
.benefit-desc {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #8a96a8;
}

.act {
  display: flex;
  align-items: center;
  background: #18222f;
  border: 1px solid #243042;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
}
.act-tag {
  flex: 0 0 auto;
  font-size: 11px;
  color: #0f1620;
  background: #4ea1ff;
  border-radius: 6px;
  padding: 3px 8px;
  margin-right: 10px;
}
.act-tag.t-green { background: #4ade80; }
.act-tag.t-gold { background: #fbbf24; }
.act-tag.t-purple { background: #a78bfa; }
.act-tag.t-gray { background: #cbd5e1; color: #475569; }
.group-k {
  font-size: 12px;
  color: #8a94a6;
  padding: 10px 4px 4px;
}
.act.past { opacity: .72; }
.act-body {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.act-title {
  font-size: 14px;
  font-weight: 600;
  color: #e8edf4;
}
.act-sub {
  font-size: 12px;
  color: #aab4c4;
  margin-top: 2px;
}
.act-reward {
  font-size: 11px;
  color: #c79a4b;
  margin-top: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.act-go {
  flex: 0 0 auto;
  font-size: 20px;
  color: #5a6678;
  margin-left: 8px;
}

.empty {
  font-size: 13px;
  color: #6b7688;
  padding: 12px 4px;
}
