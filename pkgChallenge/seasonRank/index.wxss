.page {
  min-height: 100vh;
  background-color: var(--es-ink, #03060C);
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
  color: var(--es-white, #F4F7FA);
}

.head { margin: 4rpx 4rpx 16rpx; }
.head-title { font-size: 32rpx; font-weight: 700; color: var(--es-white, #F4F7FA); }
.head-sub { font-size: 24rpx; color: var(--es-txt-2, #AAB4BE); margin-top: 4rpx; }

/* Tab */
.tabs {
  display: flex;
  background: var(--es-bg-deep, #010407);
  border: 1px solid var(--es-line, #4B5663);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 18rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--es-txt-2, #AAB4BE);
  border-radius: 999rpx;
}
.tab.active {
  background: rgba(0,191,255,0.15);
  color: var(--es-green, #00BFFF);
  font-weight: 700;
}

.hint { text-align: center; color: var(--es-txt-2, #AAB4BE); padding: 80rpx 0; font-size: 26rpx; }

/* 行 */
.row {
  display: flex;
  align-items: center;
  background: var(--es-bg-deep, #010407);
  border: 1px solid var(--es-line, #4B5663);
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}
.row.top { border-color: var(--es-green, #00BFFF); }
.row.me { border-color: var(--es-safe, #00E5A0); background: rgba(0,229,160,0.06); }
.rk { width: 56rpx; color: var(--es-txt-2, #AAB4BE); font-size: 30rpx; font-weight: 700; }
.row.top .rk { color: var(--es-green, #00BFFF); }
.info { flex: 1; }
.nm { color: var(--es-white, #F4F7FA); font-size: 30rpx; font-weight: 600; }
.meta { color: var(--es-txt-2, #AAB4BE); font-size: 22rpx; margin-top: 4rpx; }
.val { color: var(--es-green, #00BFFF); font-size: 38rpx; font-weight: 700; }

.my-rank {
  margin: 16rpx 4rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(0,229,160,0.08);
  border: 1px solid rgba(0,229,160,0.35);
  font-size: 26rpx;
  color: var(--es-safe, #00E5A0);
  text-align: center;
}

.tip { color: var(--es-txt-3, #8E98A3); font-size: 22rpx; margin-top: 24rpx; line-height: 1.6; }

.action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(3,6,12,0), rgba(3,6,12,0.96) 30%);
}
.btn-ghost {
  width: 100%;
  height: 80rpx;
  border-radius: 999rpx;
  border: 1px dashed var(--es-line, #4B5663);
  background: transparent;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
