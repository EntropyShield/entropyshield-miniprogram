.page {
  min-height: 100vh;
  background-color: var(--es-ink, #03060C);
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
  color: var(--es-white, #F4F7FA);
}

.hint { text-align: center; color: var(--es-txt-2, #AAB4BE); padding: 100rpx 0; font-size: 26rpx; }

/* 主视觉 */
.hero {
  padding: 40rpx 28rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(0,191,255,0.2), rgba(0,191,255,0.04));
  border: 1px solid rgba(0,191,255,0.3);
  text-align: center;
  margin-bottom: 20rpx;
}
.level-tag {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(0,191,255,0.5);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
  margin-bottom: 18rpx;
}
.score-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.score-num {
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--es-white, #F4F7FA);
}
.score-label { font-size: 24rpx; color: var(--es-txt-2, #AAB4BE); margin-top: 8rpx; }
.score-sub { margin-top: 10rpx; font-size: 26rpx; color: var(--es-txt-2, #AAB4BE); }

/* 卡片 */
.card {
  background-color: var(--es-bg-deep, #010407);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1px solid var(--es-line, #4B5663);
}
.card-title, .notice-title { font-size: 26rpx; font-weight: 600; margin-bottom: 14rpx; }

/* 入榜状态 */
.status-card { text-align: center; font-size: 25rpx; }
.status-card.ok { border-color: rgba(0,229,160,0.5); color: var(--es-safe, #00E5A0); }
.status-card.warn { border-color: rgba(255,176,32,0.5); color: var(--es-amber, #FFB020); }
.status-card.muted { border-color: rgba(75,86,99,0.6); color: var(--es-txt-2, #AAB4BE); }

/* 四维 */
.dim-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.dim-name { width: 140rpx; font-size: 24rpx; color: var(--es-txt-2, #AAB4BE); }
.dim-bar {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(75,86,99,0.35);
  overflow: hidden;
  margin: 0 14rpx;
}
.dim-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #00BFFF, #00E5A0);
}
.dim-pct { width: 80rpx; text-align: right; font-size: 24rpx; color: var(--es-green, #00BFFF); font-weight: 600; }
.dim-tip { font-size: 22rpx; color: var(--es-txt-3, #8E98A3); line-height: 1.6; margin-top: 4rpx; }

/* 说明 */
.notice-text { font-size: 22rpx; color: var(--es-txt-3, #8E98A3); line-height: 1.6; }

/* 底部按钮 */
.action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(3,6,12,0), rgba(3,6,12,0.96) 30%);
}
.btn-primary {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background-color: var(--es-green, #00BFFF);
  color: var(--es-ink, #03060C);
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-ghost {
  margin-top: 14rpx;
  width: 100%;
  height: 76rpx;
  border-radius: 999rpx;
  border: 1px dashed var(--es-line, #4B5663);
  background: transparent;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
