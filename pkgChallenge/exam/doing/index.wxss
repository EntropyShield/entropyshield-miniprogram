.page {
  min-height: 100vh;
  background-color: var(--es-ink, #03060C);
  padding: 20rpx 24rpx 160rpx;
  box-sizing: border-box;
  color: var(--es-white, #F4F7FA);
}

/* 顶栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 8rpx 18rpx;
}
.progress-text { font-size: 26rpx; color: var(--es-txt-2, #AAB4BE); }
.timer {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
  font-variant-numeric: tabular-nums;
}
.timer.warn { color: var(--es-amber, #FFB020); }

.hint { text-align: center; color: var(--es-txt-2, #AAB4BE); padding: 80rpx 0; font-size: 26rpx; }

/* 题目卡 */
.q-card {
  background-color: var(--es-bg-deep, #010407);
  border-radius: 22rpx;
  padding: 22rpx 22rpx 14rpx;
  margin-bottom: 18rpx;
  border: 1px solid var(--es-line, #4B5663);
}
.q-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.q-no { font-size: 24rpx; color: var(--es-txt-2, #AAB4BE); }
.q-dim {
  margin-left: 14rpx;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(0,191,255,0.3);
  color: var(--es-green, #00BFFF);
}
.q-stem { font-size: 29rpx; font-weight: 600; line-height: 1.5; margin-bottom: 16rpx; }

/* 选项 */
.options { display: flex; flex-direction: column; }
.option-item {
  display: flex;
  align-items: center;
  padding: 18rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(75,86,99,0.6);
  background: rgba(255,255,255,0.02);
}
.option-item.active {
  border-color: var(--es-green, #00BFFF);
  background: rgba(0,191,255,0.1);
}
.option-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1px solid var(--es-line, #4B5663);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.option-item.active .option-dot {
  border-color: var(--es-green, #00BFFF);
  color: var(--es-green, #00BFFF);
}
.option-text { flex: 1; font-size: 26rpx; line-height: 1.5; color: var(--es-txt-1, #F4F7FA); }

/* 底部按钮 */
.action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(3,6,12,0), rgba(3,6,12,0.96) 30%);
}
.btn-primary {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background-color: var(--es-green, #00BFFF);
  color: var(--es-ink, #03060C);
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-primary[disabled] {
  background-color: rgba(0,191,255,0.3);
  color: rgba(3,6,12,0.6);
}
