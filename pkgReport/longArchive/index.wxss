page {
  background: var(--es-ink, #03060C);
}

.la-page {
  min-height: 100vh;
  background: var(--es-ink, #03060C);
  padding: 24rpx;
  box-sizing: border-box;
}

.la-summary-card,
.la-empty-card,
.la-card {
  background: var(--es-card-2, #0F1926);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 191, 255, 0.14);
}

.la-summary-card {
  margin-bottom: 20rpx;
}

.la-summary-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.la-summary-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--es-white, #F4F7FA);
}

.la-summary-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--es-txt-2, #AAB4BE);
}

.la-summary-badge {
  min-width: 112rpx;
  text-align: center;
  padding: 10rpx 16rpx;
  height: fit-content;
  border-radius: 9999rpx;
  background: rgba(0, 191, 255, 0.12);
  color: var(--es-green, #00BFFF);
  font-size: 24rpx;
  font-weight: 700;
}

.la-summary-meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--es-txt-4, #7B8591);
}

.la-empty-card {
  margin-top: 20rpx;
}

.la-empty-title {
  display: block;
  font-size: 30rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 700;
}

.la-empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--es-txt-2, #AAB4BE);
}

.la-empty-btn,
.la-bottom-btn {
  margin-top: 20rpx;
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.la-empty-btn,
.la-bottom-btn {
  background: var(--es-green, #00BFFF);
  color: var(--es-bg-deep, #010407);
}

.la-bottom-btn-secondary {
  background: transparent;
  color: var(--es-green, #00BFFF);
  border: 2rpx solid rgba(0, 191, 255, 0.6);
}

.la-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.la-card-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.la-top-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.la-code {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--es-white, #F4F7FA);
}

.la-type {
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  color: var(--es-green, #00BFFF);
  background: rgba(0, 191, 255, 0.1);
}

.la-time {
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.la-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.la-cell {
  background: var(--es-card-2, #0F1926);
  border-radius: 18rpx;
  padding: 16rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
}

.la-label {
  display: block;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.la-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--es-white, #F4F7FA);
}

.la-strong {
  color: var(--es-green, #00BFFF);
  font-weight: 700;
}

.la-bottom-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 4rpx;
  margin-bottom: 20rpx;
}