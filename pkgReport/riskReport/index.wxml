<view class="rr-page">
  <block wx:if="{{report}}">
    <view class="rr-card rr-hero">
      <view class="rr-hero-top">
        <text class="rr-title">风控报告</text>
        <view class="rr-badge">{{report.planTypeText}}</view>
      </view>
      <text class="rr-sub">代码：{{report.code || '—'}}</text>
      <text class="rr-sub">时间：{{report.timeText || '—'}}</text>
      <text class="rr-sub">来源：{{report.source || 'riskCalculator'}}</text>
      <text class="rr-sub">版本：{{report.entryVersion || 'V1.4'}}</text>
    </view>

    <view class="rr-card">
      <view class="rr-section-title">风险摘要</view>
      <view class="rr-row"><text class="rr-k">建仓参考价</text><text class="rr-v">{{report.firstPrice || '—'}}</text></view>
      <view class="rr-row"><text class="rr-k">止损价格</text><text class="rr-v">{{report.stopLossPrice || '—'}}</text></view>
      <view class="rr-row"><text class="rr-k">计划最大风险</text><text class="rr-v">{{report.maxLossAmount || '—'}}</text></view>
      <view class="rr-row"><text class="rr-k">执行状态</text><text class="rr-v">{{report.executionStatusText}}</text></view>
      <view class="rr-row"><text class="rr-k">SRR评分</text><text class="rr-v">{{report.srrScoreText}}</text></view>
      <view class="rr-row"><text class="rr-k">报告用途</text><text class="rr-v">风险识别、规则执行与持续复盘</text></view>
    </view>

    <view class="rr-card">
      <view class="rr-section-title">AI 解读风险报告</view>

      <view wx:if="{{!aiExplainLoading}}" class="rr-btn rr-btn-primary" bindtap="runAiExplain">
        生成风险解读
      </view>
      <view wx:else class="rr-btn rr-btn-primary">
        风险解读生成中...
      </view>

      <text wx:if="{{aiExplainError}}" class="rr-sub" style="margin-top: 16rpx;">{{aiExplainError}}</text>

      <view wx:if="{{aiExplain}}" style="margin-top: 20rpx;">
        <view wx:if="{{aiExplain.summary}}" style="margin-bottom: 20rpx;">
          <text class="rr-ai-label">报告总结</text>
          <text class="rr-step-text" style="display:block;margin-top:8rpx;">{{aiExplain.summary}}</text>
        </view>

        <view wx:if="{{aiExplain.riskFocus.length}}" style="margin-bottom: 20rpx;">
          <text class="rr-ai-label">风险重点</text>
          <block wx:for="{{aiExplain.riskFocus}}" wx:key="index">
            <view class="rr-list-item">
              <text class="rr-step-text">{{item}}</text>
            </view>
          </block>
        </view>

        <view wx:if="{{aiExplain.scoreInterpretation}}" style="margin-bottom: 20rpx;">
          <text class="rr-ai-label">评分解释</text>
          <text class="rr-step-text" style="display:block;margin-top:8rpx;">{{aiExplain.scoreInterpretation}}</text>
        </view>

        <view wx:if="{{aiExplain.nextActions.length}}">
          <text class="rr-ai-label">下一步风险动作</text>
          <block wx:for="{{aiExplain.nextActions}}" wx:key="index">
            <view class="rr-list-item">
              <text class="rr-step-text">{{item}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <view class="rr-card">
      <view class="rr-section-title">评分与标签回写</view>

      <view class="rr-ai-item">
        <text class="rr-ai-label">SRR评分（0-100）</text>
        <input value="{{srrScoreInput}}" data-field="srrScoreInput" bindinput="onFormInput" type="digit" placeholder="例如 82" style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:var(--es-white, #F4F7FA);" />
      </view>

      <view class="rr-ai-item">
        <text class="rr-ai-label">执行状态</text>
        <picker mode="selector" range="{{executionOptionLabels}}" value="{{executionStatusIndex}}" bindchange="onExecutionChange">
          <view style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:var(--es-white, #F4F7FA);">
            {{executionStatusText}}
          </view>
        </picker>
      </view>

      <view class="rr-ai-item">
        <text class="rr-ai-label">偏差标签</text>
        <textarea value="{{deviationTagsInput}}" data-field="deviationTagsInput" bindinput="onFormInput" auto-height placeholder="例如：拖延止损、抢跑加仓" style="margin-top:12rpx;min-height:120rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:var(--es-white, #F4F7FA);"></textarea>
      </view>

      <view class="rr-ai-item">
        <text class="rr-ai-label">组标签</text>
        <input value="{{groupTagInput}}" data-field="groupTagInput" bindinput="onFormInput" placeholder="例如：第1组" style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:var(--es-white, #F4F7FA);" />
      </view>

      <view class="rr-ai-item">
        <text class="rr-ai-label">阶段标签</text>
        <input value="{{stageTagInput}}" data-field="stageTagInput" bindinput="onFormInput" placeholder="例如：阶段A" style="margin-top:12rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:var(--es-white, #F4F7FA);" />
      </view>

      <view class="rr-ai-item">
        <text class="rr-ai-label">档案标签</text>
        <textarea value="{{archiveTagsInput}}" data-field="archiveTagsInput" bindinput="onFormInput" auto-height placeholder="例如：执行稳定、止损合规" style="margin-top:12rpx;min-height:120rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,0.12);border-radius:20rpx;color:var(--es-white, #F4F7FA);"></textarea>
      </view>

      <view class="rr-btn rr-btn-primary" bindtap="saveEvaluation" style="margin-top: 20rpx; opacity: {{savingEvaluation ? 0.6 : 1}};">保存评分与标签</view>
    </view>

    <view class="rr-card">
      <view class="rr-section-title">执行步骤</view>
      <block wx:if="{{report.displaySteps.length}}">
        <block wx:for="{{report.displaySteps}}" wx:key="index">
          <view class="rr-list-item">
            <text class="rr-step-index">步骤{{item.index}}</text>
            <text class="rr-step-text">{{item.displayText}}</text>
          </view>
        </block>
      </block>
      <view wx:else class="rr-empty">暂无执行步骤</view>
    </view>

    <view class="rr-card">
      <view class="rr-section-title">纪律提醒</view>
      <block wx:if="{{report.disciplineTips.length}}">
        <block wx:for="{{report.disciplineTips}}" wx:key="index">
          <view class="rr-list-item">
            <text class="rr-step-text">{{item}}</text>
          </view>
        </block>
      </block>
      <view wx:else class="rr-empty">暂无纪律提醒</view>
    </view>

    <view class="rr-actions">
      <view class="rr-btn rr-btn-primary" bindtap="saveLongArchive">加入长期档案</view>
      <view class="rr-btn rr-btn-secondary" bindtap="goLongArchive">查看长期档案</view>
      <view class="rr-btn rr-btn-secondary" bindtap="goMainchainOverview">查看主链总览</view>
      <view class="rr-btn rr-btn-secondary" bindtap="goTradeRecord">查看交易记录</view>
      <view class="rr-btn rr-btn-primary" bindtap="goRiskCalculator">继续风险测算</view>
      <view class="rr-btn rr-btn-secondary" bindtap="goHome">返回首页</view>
    </view>
  </block>

  <view wx:else class="rr-card">
    <view class="rr-section-title">风控报告</view>
    <view class="rr-empty">暂无风控报告</view>
  </view>

    <disclaimer />
</view>
