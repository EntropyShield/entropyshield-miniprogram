.rr-page {
  min-height: 100vh;
  background: var(--es-bg, #03060C);
  padding: 24rpx;
  box-sizing: border-box;
}

.rr-card {
  background: var(--es-card, #07111E);
  border: 2rpx solid rgba(0, 191, 255, 0.15);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.rr-hero {
  background: linear-gradient(180deg, rgba(0, 191, 255,0.08), rgba(17,24,39,1));
}

.rr-hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.rr-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--es-white, #F4F7FA);
}

.rr-badge {
  font-size: 24rpx;
  color: var(--es-on-green, #03060C);
  background: var(--es-green, #00BFFF);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}

.rr-sub {
  display: block;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
  line-height: 1.8;
  margin-bottom: 6rpx;
}

.rr-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
  margin-bottom: 18rpx;
}

.rr-ai-item,
.rr-list-item,
.rr-row {
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.rr-ai-label,
.rr-k,
.rr-step-index {
  display: block;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
  margin-bottom: 8rpx;
}

.rr-ai-value,
.rr-v,
.rr-step-text,
.rr-empty {
  display: block;
  font-size: 28rpx;
  color: var(--es-white, #F4F7FA);
  line-height: 1.7;
  word-break: break-all;
}

.rr-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.rr-btn {
  text-align: center;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.rr-btn-primary {
  background: var(--es-green, #00BFFF);
  color: var(--es-on-green, #03060C);
}

.rr-btn-secondary {
  background: var(--es-card, #07111E);
  color: var(--es-white, #F4F7FA);
  border: 2rpx solid rgba(255,255,255,0.12);
}