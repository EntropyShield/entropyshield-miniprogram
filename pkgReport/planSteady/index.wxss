/* pages/planSteady/index.wxss */

/* 页面整体 */
.ps-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  background-color: var(--es-ink, #000000);
  box-sizing: border-box;
  color: var(--es-white, #ffffff);
}

/* 通用卡片 */
.card {
  background: var(--es-bg-deep, #050505);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--es-green-20, #00E5A033);
  box-shadow: 0 0 24rpx rgba(0, 229, 160, 0.12);
  margin-bottom: 24rpx;
}

/* 顶部总览卡片 */
.ps-summary-header {
  margin-bottom: 16rpx;
}

.ps-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0c0c0c;
  background: linear-gradient(90deg, var(--es-green, #00E5A0), #63ff8f);
  font-weight: 600;
}

.ps-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  padding: 6rpx 0;
}

.ps-label {
  color: var(--es-txt-2, #9aa0a6);
}

.ps-value {
  color: var(--es-white, #ffffff);
}

.ps-value-strong {
  color: var(--es-green, #00E5A0);
  font-weight: 600;
}

.ps-summary-split {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--es-green-20, #00E5A033), transparent);
  margin: 12rpx 0 4rpx;
}

/* 分批建仓部分 */
.ps-steps {
  margin-top: 8rpx;
}

.ps-section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.ps-step-block {
  padding: 18rpx 0 10rpx;
  border-top: 1rpx solid #1c1c1c;
}

.ps-step-block:first-child {
  border-top-width: 0;
}

.ps-step-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.ps-step-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--es-green, #00E5A0);
  margin-right: 10rpx;
}

.ps-step-title {
  font-size: 26rpx;
  color: var(--es-green, #00E5A0);
  font-weight: 600;
}

/* 每一档细节信息网格展示 */
.ps-step-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.ps-step-item {
  width: 50%;
  padding: 4rpx 0;
  font-size: 24rpx;
}

.ps-value-warning {
  color: #ff5c5c;
}

/* 底部提示 */
.ps-tip {
  font-size: 22rpx;
  color: #666c72;
  line-height: 1.6;
  margin: 4rpx 8rpx 12rpx;
}

/* 底部按钮区域 */
.ps-bottom {
  margin: 0 24rpx;
}

.ps-bottom-btn {
  height: 88rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--es-green, #00E5A0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}

.ps-bottom-btn text {
  font-size: 30rpx;
  color: var(--es-green, #00E5A0);
  font-weight: 600;
}

/* 次要按钮：空心 + 淡绿色文字 */
.ps-bottom-btn-secondary {
  background-color: transparent;
  border-color: var(--es-green-40, #00E5A066);
}

.ps-bottom-btn-secondary text {
  font-size: 26rpx;
  font-weight: 500;
  color: #c0ffc0;
}


/* 正式方案参数填写区 */
.ps-form-field { margin-top: 22rpx; }
.ps-form-label { display:block; margin-bottom:10rpx; color:var(--es-txt-2, #9aa0a6); font-size:24rpx; }
.ps-form-input,.ps-form-picker { min-height:80rpx; padding:0 22rpx; border:1rpx solid #00E5A044; border-radius:16rpx; background:var(--es-on-green, #0b0b0b); color:var(--es-white, #fff); font-size:28rpx; box-sizing:border-box; }
.ps-form-input { height:80rpx; }
.ps-form-picker { display:flex; align-items:center; justify-content:space-between; }
.ps-form-picker-desc { color:#7f878d; font-size:22rpx; margin-left:16rpx; }
.ps-risk-rule { margin-top:24rpx; padding:20rpx; border-radius:16rpx; border:1rpx solid #00E5A055; background:rgba(0, 229, 160,.06); }
.ps-risk-rule-row { display:flex; align-items:center; justify-content:space-between; font-size:27rpx; }
.ps-risk-rule-desc { display:block; margin-top:10rpx; color:var(--es-txt-2, #9aa0a6); font-size:22rpx; line-height:1.6; }
.ps-generate-btn,.ps-edit-btn { margin-top:24rpx; border-radius:999rpx; background:var(--es-green, #00E5A0); color:var(--es-ink, #000); font-size:28rpx; font-weight:700; }
.ps-edit-btn { background:transparent; color:var(--es-green, #00E5A0); border:1rpx solid var(--es-green, #00E5A0); }
.ps-summary-row { gap:24rpx; align-items:flex-start; }
.ps-summary-row .ps-value { max-width:64%; text-align:right; word-break:break-all; }
.ps-step-item { box-sizing:border-box; padding-right:12rpx; }
.ps-step-item .ps-label,.ps-step-item .ps-value { display:block; }

/* ====== [MOD:PLANSTEADY_MAINCHAIN_ENTRY_20260402] START ====== */
.result-entry-card {
  margin: 24rpx 24rpx 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(0, 229, 160, 0.35);
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(7, 20, 18, 0.96), rgba(10, 16, 28, 0.96));
  box-sizing: border-box;
}

.result-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8FFF0;
  line-height: 1.4;
}

.result-entry-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(232, 255, 240, 0.68);
  line-height: 1.6;
}

.result-entry-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 22rpx;
}

.result-entry-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 18rpx;
  border: 1rpx solid rgba(0, 229, 160, 0.35);
  background: rgba(10, 18, 16, 0.92);
  color: #D8FFE3;
  font-size: 28rpx;
  font-weight: 600;
}

.result-entry-btn--primary {
  color: #08120C;
  background: linear-gradient(180deg, #39FF5A 0%, #17D83A 100%);
  border-color: rgba(57, 255, 90, 0.9);
}
/* ====== [MOD:PLANSTEADY_MAINCHAIN_ENTRY_20260402] END ====== */

.ps-loading,
.ps-error {
  margin: 32rpx;
  padding: 36rpx;
  text-align: center;
}

.ps-error-title,
.ps-error-desc {
  display: block;
  margin-bottom: 20rpx;
}

.result-loss {
  color: #d93025 !important;
  font-weight: 700;
}

.result-profit {
  color: #168c4a !important;
  font-weight: 700;
}

.result-neutral {
  color: #667085 !important;
  font-weight: 700;
}
