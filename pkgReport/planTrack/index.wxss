.page {
  min-height: 100vh;
  background: #0f1620;
  padding: 16px;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
}
.hero-title {
  font-size: 22px;
  font-weight: 700;
  color: #e8edf4;
}
.hero-sub {
  margin-top: 4px;
  font-size: 12px;
  color: #8a96a8;
}

.card {
  background: #18222f;
  border: 1px solid #243042;
  border-radius: 14px;
  padding: 14px;
  margin-bottom: 12px;
}
.card-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 12px;
}
.stock {
  font-size: 16px;
  font-weight: 700;
  color: #e8edf4;
  margin-right: 8px;
}
.code {
  font-size: 12px;
  color: #6b7688;
}

.row {
  display: flex;
  justify-content: space-between;
}
.cell {
  display: flex;
  flex-direction: column;
  flex: 1 1 0;
}
.label {
  font-size: 11px;
  color: #8a96a8;
}
.value {
  font-size: 16px;
  font-weight: 600;
  color: #e8edf4;
  margin-top: 2px;
}
.value.muted {
  color: #5a6678;
}
.value.up {
  color: #ff6b6b;
}
.value.down {
  color: #2ecc71;
}

.err {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  color: #ff9f43;
}

.empty {
  font-size: 13px;
  color: #6b7688;
  padding: 24px 8px;
  line-height: 1.6;
}

.foot {
  margin-top: 8px;
  font-size: 11px;
  color: #5a6678;
  line-height: 1.6;
}
