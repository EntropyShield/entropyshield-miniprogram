.page {
  background-color: var(--es-ink, #03060C);
  min-height: 100vh;
  padding: 32rpx 32rpx 40rpx;
  box-sizing: border-box;
  color: var(--es-white, #F4F7FA);
}

/* 头部标题区 */
.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
}

/* 筛选 Tab */
.filter-tab {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  background-color: var(--es-bg-deep, #010407);
  border-radius: 999rpx;
  padding: 4rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--es-txt-2, #AAB4BE);
  border-radius: 999rpx;
}

.tab-item.active {
  background-color: var(--es-green, #00BFFF);
  color: var(--es-ink, #03060C);
  font-weight: 600;
}

/* 状态 / 错误提示 */
.tip-text {
  text-align: center;
  color: var(--es-txt-3, #8E98A3);
  margin-top: 40rpx;
  font-size: 26rpx;
}

.tip-error {
  color: var(--es-red, #FF4D5E);
}

/* 列表滚动区 */
.course-scroll {
  height: calc(100vh - 220rpx - env(safe-area-inset-bottom));
}

/* 日期行 */
.date-row {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.date-text {
  font-size: 24rpx;
  color: var(--es-txt-3, #8E98A3);
}

/* 课程卡片 */
.course-card {
  background-color: var(--es-card, #07111E);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

/* 顶部：标题 + 类型 */
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
}

.title-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: var(--es-green, #00BFFF);
  margin-right: 8rpx;
}

.course-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--es-white, #F4F7FA);
}

/* 类型标签（promo / lead / paid / camp） */
.type-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--es-txt-1, #F4F7FA);
  border: 1rpx solid var(--es-line, #4B5663);
}

/* 中部：时间 + 状态 */
.card-middle {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.time-text {
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
}

/* 状态标签：未开始 / 进行中 / 已完成 */
.status-tag {
  min-width: 120rpx;
  text-align: center;
  padding: 6rpx 0;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-not_started {
  background-color: var(--es-card-2, #0F1926);
  color: var(--es-txt-1, #F4F7FA);
}

.status-in_progress {
  background-color: var(--es-green, #00BFFF);
  color: var(--es-ink, #03060C);
  font-weight: 600;
}

.status-finished {
  background-color: var(--es-card-2, #0F1926);
  color: var(--es-txt-3, #8E98A3);
}

/* 底部进度条（可选） */
.card-bottom {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
}

.progress-bar {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background-color: var(--es-surface, #0F1926);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background-color: var(--es-green, #00BFFF);
}

.progress-label {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

/* 空列表提示 */
.empty-tip {
  margin-top: 80rpx;
  text-align: center;
  color: var(--es-txt-3, #8E98A3);
  font-size: 26rpx;
}
