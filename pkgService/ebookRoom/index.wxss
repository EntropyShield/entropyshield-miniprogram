/* pkgService/ebookRoom/index.wxss —— 守护者电子书房 */
.room {
  min-height: 100vh;
  background: #03060C;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}
.head {
  padding: 16rpx 8rpx 24rpx;
  border-bottom: 1rpx solid #16202c;
  margin-bottom: 24rpx;
}
.head-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #EAF2FF;
}
.head-sub {
  font-size: 22rpx;
  color: #7B8591;
  margin-top: 8rpx;
}

.state {
  text-align: center;
  color: #7B8591;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
}
.empty-emoji { font-size: 80rpx; }
.empty-title {
  font-size: 32rpx;
  color: #EAF2FF;
  font-weight: 700;
  margin-top: 20rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #7B8591;
  margin-top: 12rpx;
  line-height: 1.6;
}
.empty-btn {
  margin-top: 36rpx;
  background: #00E0A1;
  color: #031a12;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 48rpx;
  line-height: 2.4;
}

.book-list { display: flex; flex-direction: column; gap: 18rpx; }
.book {
  display: flex;
  background: #0a0f17;
  border: 1rpx solid #16202c;
  border-radius: 18rpx;
  padding: 22rpx;
}
.book-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 10rpx;
  background: #16202c;
  flex-shrink: 0;
}
.book-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.book-info { flex: 1; margin-left: 22rpx; min-width: 0; }
.book-title {
  font-size: 30rpx;
  color: #EAF2FF;
  font-weight: 600;
}
.book-author {
  font-size: 22rpx;
  color: #9fb0c0;
  margin-top: 6rpx;
}
.book-intro {
  font-size: 20rpx;
  color: #7B8591;
  margin-top: 10rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.book-read {
  font-size: 22rpx;
  color: #00BFFF;
  margin-top: 14rpx;
}
