page {
  background: var(--es-bg-deep, #010407);
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: var(--es-bg-deep, #010407);
  box-sizing: border-box;
}

.summary-card,
.card {
  margin-bottom: 12rpx;
  background: linear-gradient(180deg, var(--es-card, #07111E) 0%, var(--es-card, #07111E) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 22rpx;
  padding: 22rpx;
}

.summary-card {
  margin-bottom: 20rpx;
  background: linear-gradient(180deg, var(--es-card, #07111E) 0%, var(--es-card, #07111E) 100%);
  border: 1rpx solid rgba(0, 191, 255, 0.10);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.summary-title {
  font-size: 32rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
}

.refresh-btn {
  background: linear-gradient(90deg, var(--es-safe, #00E5A0), var(--es-green, #00BFFF));
  color: var(--es-bg-deep, #010407);
  border-radius: 9999rpx;
  font-size: 22rpx;
}

.current-id-row {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 18rpx;
}

.current-id-label {
  display: block;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
  line-height: 1.5;
}

.current-id-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
  word-break: break-all;
  line-height: 1.6;
}

.summary-grid {
  display: flex;
  gap: 12rpx;
}

.summary-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 18rpx;
  padding: 18rpx 12rpx;
  text-align: center;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
  line-height: 1.5;
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  color: var(--es-green, #00BFFF);
  font-weight: 600;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
}

.card {
  margin-bottom: 12rpx;
}

.name {
  font-size: 30rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 700;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--es-txt-1, #F4F7FA);
  word-break: break-all;
  line-height: 1.7;
}

.empty {
  padding: 24rpx;
  text-align: center;
  color: var(--es-txt-1, #F4F7FA);
  font-size: 24rpx;
  background: linear-gradient(180deg, var(--es-card, #07111E) 0%, var(--es-card, #07111E) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 22rpx;
  line-height: 1.7;
}


/* ====== INVITETRACKER FINAL READABILITY OVERRIDE START ====== */
.summary-card {
  background: linear-gradient(180deg, var(--es-card, #07111E) 0%, var(--es-card, #07111E) 100%) !important;
  border: 1rpx solid rgba(0, 191, 255, 0.12) !important;
}

.current-id-row {
  background: rgba(255, 255, 255, 0.03) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.06) !important;
}

.card {
  background: linear-gradient(180deg, var(--es-elevated, #151F2C) 0%, var(--es-elevated, #151F2C) 100%) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.06) !important;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.16) !important;
}

.card-top {
  align-items: flex-start !important;
}

.name-wrap {
  min-width: 0;
}

.card .name {
  color: var(--es-white, #F4F7FA) !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  line-height: 1.5 !important;
}

.card .sub-id {
  display: block !important;
  margin-top: 8rpx !important;
  color: var(--es-txt-1, #F4F7FA) !important;
  font-size: 22rpx !important;
  line-height: 1.7 !important;
  word-break: break-all !important;
}

.card .meta {
  display: block !important;
  margin-top: 8rpx !important;
  color: var(--es-txt-1, #F4F7FA) !important;
  font-size: 22rpx !important;
  line-height: 1.7 !important;
  word-break: break-all !important;
}

.card .identity-pill-real {
  color: var(--es-green, #00BFFF) !important;
  background: rgba(0, 191, 255, 0.14) !important;
  border: 1rpx solid rgba(0, 191, 255, 0.18) !important;
}

.card .identity-pill-temp {
  color: var(--es-amber, #FFB020) !important;
  background: rgba(255, 184, 0, 0.16) !important;
  border: 1rpx solid rgba(255, 184, 0, 0.20) !important;
}

.empty {
  color: var(--es-txt-1, #F4F7FA) !important;
  background: linear-gradient(180deg, var(--es-elevated, #151F2C) 0%, var(--es-elevated, #151F2C) 100%) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.06) !important;
}
/* ====== INVITETRACKER FINAL READABILITY OVERRIDE END ====== */


/* ====== INVITETRACKER CURRENT ID TIP FIX START ====== */
.current-id-row {
  background: rgba(255, 255, 255, 0.03) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.08) !important;
  border-radius: 16rpx !important;
  padding: 18rpx 20rpx !important;
}

.current-id-label {
  color: var(--es-txt-2, #AAB4BE) !important;
  font-size: 22rpx !important;
}

.current-id-value {
  color: var(--es-white, #F4F7FA) !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  line-height: 1.6 !important;
}

.current-id-tip {
  display: block !important;
  margin-top: 10rpx !important;
  color: var(--es-txt-1, #F4F7FA) !important;
  font-size: 24rpx !important;
  line-height: 1.8 !important;
  word-break: break-all !important;
  opacity: 1 !important;
}
/* ====== INVITETRACKER CURRENT ID TIP FIX END ====== */

