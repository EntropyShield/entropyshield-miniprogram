page {
  background: var(--es-ink, #03060C);
}
.page {
  min-height: 100vh;
  background: var(--es-ink, #03060C);
}


.loading-text {
  margin-top: 80rpx;
  text-align: center;
  color: var(--es-txt-2, #AAB4BE);
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: var(--es-txt-2, #AAB4BE);
}

.empty-title {
  font-size: 32rpx;
  color: var(--es-txt-1, #F4F7FA);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.primary-btn {
  margin: 0 80rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--es-safe, #00E5A0), var(--es-green, #00BFFF));
  color: var(--es-bg, #03060C);
  font-size: 30rpx;
  font-weight: 600;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background-color: var(--es-card, #07111E);
  border-radius: 24rpx;
  padding: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.date {
  font-size: 28rpx;
  color: var(--es-txt-1, #F4F7FA);
}

.status {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-pending {
  background-color: var(--es-card, #07111E);
  color: var(--es-amber, #FFB020);
}

.status-confirmed {
  background-color: var(--es-safe-bg, rgba(0, 229, 160, .12));
  color: var(--es-safe, #00E5A0);
}

.status-done {
  background-color: var(--es-card, #07111E);
  color: var(--es-safe, #00E5A0);
}

.status-cancel {
  background-color: var(--es-red-bg, rgba(255, 77, 94, .12));
  color: var(--es-red, #FF4D5E);
}

.row {
  display: flex;
  margin-bottom: 4rpx;
  font-size: 26rpx;
}

.label {
  color: var(--es-txt-2, #AAB4BE);
}

.value {
  color: var(--es-txt-1, #F4F7FA);
}

.created-at {
  margin-top: 8rpx;
}

/* 顶部日期 + 时间段行美化 */
.date-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--es-txt-1, #F4F7FA);
}

.date-dot {
  font-size: 26rpx;
  color: var(--es-txt-3, #8E98A3);
}

.date-time {
  font-size: 26rpx;
  color: var(--es-txt-2, #AAB4BE);
}

/* 卡片底部操作区 */
.card-footer {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

/* 取消预约按钮 */
.btn-cancel {
  padding: 12rpx 40rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--es-red, #FF4D5E);
  border: 1rpx solid rgba(248, 113, 113, 0.8);
  background-color: transparent;
}

/* 去掉小程序原生 button 默认背景 */
.btn-cancel::after {
  border: none;
}
