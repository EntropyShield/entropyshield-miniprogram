.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 32rpx;
  background-color: var(--es-bg-deep, #010407);
}

.header {
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--es-white, #F4F7FA);
}

.header-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.filter-bar {
  display: flex;
  align-items: center;
  background-color: var(--es-card-2, #0F1926);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
  border-radius: 999rpx;
}

.tab.active {
  background-color: var(--es-green-bright, #00E8FF);
  color: var(--es-bg-deep, #010407);
  font-weight: 600;
}

.tip-text {
  padding: 40rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9da2b8;
}

.tip-error {
  color: #ff5b5b;
}

.list {
  flex: 1;
}

.card {
  background-color: var(--es-card-2, #0F1926);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.card-main {
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--es-white, #F4F7FA);
}

.card-time {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #a0a4ba;
}

.card-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-progress {
  background-color: rgba(25, 255, 95, 0.18);
  color: var(--es-green-bright, #00E8FF);
}

.status-finished {
  background-color: rgba(85, 214, 255, 0.2);
  color: #55d6ff;
}

.progress-text {
  font-size: 24rpx;
  color: var(--es-white, #F4F7FA);
}

.progress-bar {
  margin-top: 10rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.progress-inner {
  height: 12rpx;
  border-radius: 999rpx;
  background-color: var(--es-green-bright, #00E8FF);
}

.card-last,
.card-updated {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.card-actions {
  margin-top: 6rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-primary {
  background-color: var(--es-green-bright, #00E8FF);
  color: var(--es-bg-deep, #010407);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.btn-secondary {
  background-color: rgba(255, 255, 255, 0.06);
  color: var(--es-white, #F4F7FA);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}
