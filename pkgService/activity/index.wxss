.page { min-height: 100vh; background: var(--es-bg, #F5F7FA); padding: 24rpx 24rpx 200rpx; box-sizing: border-box; }
.loading, .empty { display: flex; align-items: center; justify-content: center; padding: 120rpx 0; }
.loading-text, .empty-text { font-size: var(--fs-base, 28rpx); color: var(--es-txt-3, #8E98A3); }

.hero { border-radius: 20rpx; padding: 36rpx 32rpx; color: #fff; position: relative; background: linear-gradient(135deg, #4C6EF5, #7048E8); }
.hero.t-green { background: linear-gradient(135deg, #12B886, #0CA678); }
.hero.t-gold { background: linear-gradient(135deg, #F59F00, #E8590C); }
.hero.t-purple { background: linear-gradient(135deg, #7950F2, #5F3DC4); }
.hero.t-gray { background: linear-gradient(135deg, #868E96, #495057); }
.tag { display: inline-block; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.22); margin-bottom: 16rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.sub { display: block; font-size: 24rpx; opacity: .9; margin-top: 12rpx; line-height: 1.6; }
.time { display: block; font-size: 22rpx; opacity: .85; margin-top: 20rpx; }
.phase { position: absolute; top: 32rpx; right: 32rpx; font-size: 20rpx; padding: 6rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.22); }
.phase.p-live { background: #E6FCF5; color: #0CA678; }
.phase.p-upcoming { background: #FFF3BF; color: #A07C00; }
.phase.p-past { background: rgba(0,0,0,.15); color: #fff; }

.card { background: #fff; border-radius: 16rpx; padding: 28rpx 28rpx; margin-top: 24rpx; }
.card-k { display: block; font-size: 22rpx; color: var(--es-txt-3, #8E98A3); margin-bottom: 12rpx; }
.card-v { display: block; font-size: 28rpx; color: var(--es-txt-1, #1A1F26); line-height: 1.6; }
.card-body { display: block; font-size: 26rpx; color: var(--es-txt-2, #4A5560); line-height: 1.9; white-space: pre-wrap; }
.card.gift { background: #E6FCF5; }
.card.gift .card-v { color: #0CA678; }

.cta-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06); }
.cta { width: 100%; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; background: linear-gradient(135deg, #4C6EF5, #7048E8); color: #fff; font-size: 30rpx; font-weight: 600; border: none; }
.cta.off { background: #E9ECEF; color: #ADB5BD; }
.cta-tip { margin-top: 12rpx; text-align: center; font-size: 20rpx; color: var(--es-txt-3, #8E98A3); }

.foot-card { margin-top: 24rpx; background: #fff; border-radius: 16rpx; padding: 26rpx 28rpx; display: flex; align-items: center; justify-content: space-between; }
.foot-t { display: block; font-size: 28rpx; color: var(--es-txt-1, #1A1F26); font-weight: 600; }
.foot-s { display: block; font-size: 22rpx; color: var(--es-txt-3, #8E98A3); margin-top: 8rpx; }
.foot-arrow { font-size: 40rpx; color: #C3CBD3; }
