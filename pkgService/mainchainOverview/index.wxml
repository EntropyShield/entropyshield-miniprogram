<view class="mc-page">
  <view class="mc-hero">
    <view class="mc-hero-top">
      <view class="mc-hero-left">
        <text class="mc-title">主链总览</text>
        <text class="mc-sub">先看风险边界，再看执行与复盘。</text>
      </view>
      <view class="mc-badge">已跑通</view>
    </view>

    <view class="mc-metrics">
      <view class="mc-metric">
        <text class="mc-metric-label">交易记录</text>
        <text class="mc-metric-value">{{tradeCount}}</text>
      </view>
      <view class="mc-metric">
        <text class="mc-metric-label">风控报告</text>
        <text class="mc-metric-value">{{reportCount}}</text>
      </view>
      <view class="mc-metric">
        <text class="mc-metric-label">长期档案</text>
        <text class="mc-metric-value">{{archiveCount}}</text>
      </view>
    </view>
  </view>

  <view class="mc-card">
    <view class="mc-section-title">最新交易记录</view>
    <view wx:if="{{latestTrade}}" class="mc-item">
      <view class="mc-item-top">
        <text class="mc-item-title">{{latestTrade.code || '—'}}</text>
        <text class="mc-item-tag">{{planTypeMap[latestTrade.planType] || latestTrade.planType || '当前方案'}}</text>
      </view>
      <text class="mc-item-sub">来源：{{latestTrade.source || 'tradeRecord'}}</text>
      <text class="mc-item-sub">风险口径：{{latestTrade.maxLossAmount || latestTrade.riskAmount || latestTrade.totalRisk || latestTrade.totalLoss || '—'}}</text>
      <text class="mc-item-sub">目标价：{{latestTrade.targetPrice || latestTrade.takeProfitPrice || latestTrade.target || '—'}}</text>
      <text class="mc-item-time" wx:if="{{latestTradeTime}}">时间：{{latestTradeTime}}</text>
    </view>
    <view wx:else class="mc-empty">暂无交易记录</view>
  </view>

  <view class="mc-card">
    <view class="mc-section-title">最新风控报告</view>
    <view wx:if="{{latestReport}}" class="mc-item">
      <view class="mc-item-top">
        <text class="mc-item-title">{{latestReport.code || '—'}}</text>
        <text class="mc-item-tag">{{planTypeMap[latestReport.planType] || latestReport.planType || '当前方案'}}</text>
      </view>
      <text class="mc-item-sub">来源：{{latestReport.source || 'riskCalculator'}}</text>
      <text class="mc-item-sub">版本：{{latestReport.entryVersion || 'V1.4'}}</text>
      <text class="mc-item-sub">风险口径：{{latestReport.maxLossAmount || latestReport.riskAmount || latestReport.totalRisk || latestReport.totalLoss || '—'}}</text>
      <text class="mc-item-sub">目标价：{{latestReport.targetPrice || '—'}}</text>
      <text class="mc-item-time" wx:if="{{latestReportTime}}">时间：{{latestReportTime}}</text>
    </view>
    <view wx:else class="mc-empty">暂无风控报告</view>
  </view>

  <view class="mc-card">
    <view class="mc-section-title">最近长期档案</view>
    <view wx:if="{{latestArchive}}" class="mc-item">
      <view class="mc-item-top">
        <text class="mc-item-title">{{latestArchive.code || '—'}}</text>
        <text class="mc-item-tag">{{planTypeMap[latestArchive.planType] || latestArchive.planType || '当前方案'}}</text>
      </view>
      <text class="mc-item-sub">来源：{{latestArchive.source || 'longArchive'}}</text>
      <text class="mc-item-sub">目标口径：{{latestArchive.targetPrice || latestArchive.targetProfit || '—'}}</text>
      <text class="mc-item-time" wx:if="{{latestArchiveTime}}">时间：{{latestArchiveTime}}</text>
    </view>
    <view wx:else class="mc-empty">暂无长期档案</view>
  </view>

  <view class="mc-card">
    <view class="mc-section-title">AI主链问答</view>

    <input
      class="mc-input"
      placeholder="例如：当前状态、最新交易记录怎么看、下一步做什么"
      value="{{questionInput}}"
      bindinput="onQuestionInput"
      confirm-type="send"
    />

    <view class="mc-presets">
      <view
        class="mc-chip"
        wx:for="{{quickQuestions}}"
        wx:key="*this"
        data-q="{{item}}"
        bindtap="fillPreset"
      >
        {{item}}
      </view>
    </view>

    <view wx:if="{{!aiLoading}}" class="mc-btn mc-btn-primary" bindtap="askQuestion">开始提问</view>
<view wx:else class="mc-btn mc-btn-primary">AI 分析中...</view>
<text class="mc-item-sub" wx:if="{{aiLoading}}">AI 正在分析当前主链，请稍候。</text>
<text class="mc-item-sub" wx:if="{{aiError}}">{{aiError}}</text>

    <view wx:if="{{qaHistory.length}}">
      <block wx:for="{{qaHistory}}" wx:key="index">
        <view class="mc-qa-item">
          <text class="mc-qa-q">问：{{item.q}}</text>
          <text class="mc-qa-a">答：{{item.a}}</text>
        </view>
      </block>
    </view>
    <view wx:else class="mc-empty">暂无问答记录</view>
  </view>

  <view class="mc-actions">
    <view class="mc-btn mc-btn-secondary" bindtap="goTradeRecord">查看我的交易记录</view>
    <view class="mc-btn mc-btn-secondary" bindtap="goRiskReport">查看最新风控报告</view>
    <view class="mc-btn mc-btn-secondary" bindtap="goLongArchive">查看长期档案</view>
    <view class="mc-btn mc-btn-primary" bindtap="goRiskCalculator">继续生成方案</view>
    <view class="mc-btn mc-btn-secondary" bindtap="goHome">返回首页</view>
  </view>

  <!-- [V2.0-G7] 调试入口已从生产移除（mainchainDebug 页面已于 2026-09-01 从 app.json 除名）。
       本地调试如需恢复，请同时在 app.json 重新注册该页面。
  <navigator url="/pages/mainchainDebug/index" open-type="navigate" hover-class="none">
    查看主链调试页
  </navigator>
  -->
</view>