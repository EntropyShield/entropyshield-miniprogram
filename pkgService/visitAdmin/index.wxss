page {
  background: var(--es-ink, #03060C);
}

.page {
  min-height: 100vh;
  background: var(--es-ink, #03060C);
}

.admin-header {
  margin-bottom: 20rpx;
}

.admin-title {
  font-size: 32rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
  margin-bottom: 6rpx;
}

.admin-subtitle {
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.status-tabs {
  display: flex;
  align-items: center;
  background: var(--es-card-2, #0F1926);
  border-radius: 9999rpx;
  padding: 4rpx;
  margin-bottom: 18rpx;
}

.status-tab {
  flex: 1;
  padding: 10rpx 0;
  border-radius: 9999rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.status-tab-label {
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.status-tab-count {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--es-txt-3, #8E98A3);
}

.status-tab.active {
  background: linear-gradient(90deg, var(--es-safe, #00E5A0), var(--es-green, #00BFFF));
}

.status-tab.active .status-tab-label,
.status-tab.active .status-tab-count {
  color: var(--es-bg-deep, #010407);
  font-weight: 600;
}

.list-wrap {
  margin-top: 4rpx;
}

.visit-card {
  background: var(--es-card-2, #0F1926);
  border-radius: 24rpx;
  padding: 20rpx 20rpx 16rpx;
  margin-bottom: 16rpx;
}

.visit-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.visit-date-time {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--es-white, #F4F7FA);
}

.visit-date {
  font-weight: 600;
}

.visit-dot {
  margin: 0 6rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.visit-time {
  font-size: 24rpx;
  color: var(--es-txt-4, #7B8591);
}

.status-pill {
  padding: 4rpx 12rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-pill-pending {
  background: rgba(255, 184, 0, 0.16);
  color: var(--es-amber, #FFB020);
}

.status-pill-confirmed {
  background: rgba(0, 160, 255, 0.18);
  color: var(--es-blue, #006CFF);
}

.status-pill-done {
  background: rgba(0, 191, 255, 0.18);
  color: var(--es-safe, #00E5A0);
}

.status-pill-cancel {
  background: rgba(255, 71, 71, 0.18);
  color: var(--es-red, #FF4D5E);
}

.visit-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 4rpx;
}

.visit-label {
  width: 140rpx;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.visit-value {
  flex: 1;
  font-size: 22rpx;
  color: var(--es-white, #F4F7FA);
}

.visit-meta .visit-label {
  color: var(--es-txt-3, #8E98A3);
}

.visit-meta .visit-value {
  color: var(--es-txt-2, #AAB4BE);
}

.btn-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-group {
  display: flex;
  gap: 12rpx;
}

.btn-small {
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  border: none;
}

.btn-confirm {
  background: rgba(0, 160, 255, 0.2);
  color: var(--es-blue, #006CFF);
}

.btn-done {
  background: rgba(0, 191, 255, 0.2);
  color: var(--es-safe, #00E5A0);
}

.btn-cancel {
  background: rgba(255, 71, 71, 0.2);
  color: var(--es-red, #FF4D5E);
}

.btn-small.is-disabled,
.btn-small[disabled] {
  opacity: 0.42;
  filter: saturate(0.65);
}

.empty {
  margin-top: 80rpx;
  text-align: center;
}

.empty-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 30rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
}

.empty-text {
  display: block;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
  line-height: 1.6;
}
