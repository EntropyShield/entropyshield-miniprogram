page {
  background: var(--es-bg-deep, #010407);
  min-height: 100%;
}
.page {
  min-height: 100vh;
  background: var(--es-bg-deep, #010407);
  padding: 24rpx;
  box-sizing: border-box;
}

.audit-card,
.panel,
.summary-card,
.card,
.rank-card {
  background: var(--es-card-2, #0F1926);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.audit-title {
  font-size: 30rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 700;
}

.audit-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--es-txt-2, #AAB4BE);
}

.audit-loading {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.audit-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 16rpx;
}

.audit-item {
  background: var(--es-card-2, #0F1926);
  border-radius: 18rpx;
  padding: 18rpx;
}

.audit-item-label {
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}

.audit-item-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
}

.audit-foot {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--es-txt-4, #7B8591);
}

.top-tabs {
  display: flex;
  background: var(--es-card-2, #0F1926);
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.top-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 28rpx;
  font-weight: 600;
}

.top-tab.active {
  background: linear-gradient(90deg, #18b74b, var(--es-green, #00BFFF));
  color: var(--es-bg-deep, #010407);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--es-white, #F4F7FA);
  margin-bottom: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--es-card-2, #0F1926);
  color: var(--es-txt-4, #7B8591);
  font-size: 24rpx;
}

.chip-active {
  background: var(--es-green, #00BFFF);
  color: var(--es-bg-deep, #010407);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--es-card-2, #0F1926);
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--es-white, #F4F7FA);
  box-sizing: border-box;
}

.search-btn {
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 16rpx;
  background: var(--es-green, #00BFFF);
  color: var(--es-bg-deep, #010407);
  font-size: 26rpx;
  font-weight: 700;
}

.search-btn.ghost {
  background: #2a2d33;
  color: var(--es-white, #F4F7FA);
}

.summary-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-title {
  font-size: 28rpx;
  color: var(--es-txt-4, #7B8591);
}

.summary-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--es-green, #00BFFF);
}

.loading,
.empty {
  text-align: center;
  color: var(--es-txt-2, #AAB4BE);
  font-size: 26rpx;
  padding: 40rpx 0;
}

.card-head,
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-head {
  margin-bottom: 18rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
  word-break: break-all;
  flex: 1;
  margin-right: 16rpx;
}

.status-tag {
  padding: 8rpx 16rpx;
  background: rgba(0, 191, 255,0.12);
  color: var(--es-green, #00BFFF);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.row {
  margin-bottom: 12rpx;
}

.label {
  font-size: 24rpx;
  color: var(--es-txt-2, #AAB4BE);
  width: 160rpx;
}

.value {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: var(--es-white, #F4F7FA);
  word-break: break-all;
}

.strong {
  font-weight: 700;
  color: var(--es-green, #00BFFF);
}

.rank-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rank-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.rank-no {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--es-green, #00BFFF);
  color: var(--es-bg-deep, #010407);
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 18rpx;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 28rpx;
  color: var(--es-white, #F4F7FA);
  font-weight: 600;
}

.rank-openid {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
  word-break: break-all;
}

.rank-right {
  text-align: right;
  margin-left: 20rpx;
}

.rank-value {
  font-size: 32rpx;
  color: var(--es-green, #00BFFF);
  font-weight: 700;
}

.rank-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
}
.page-wrap {
  background: var(--es-bg-deep, #010407);
  min-height: 100vh;
}

/* [V2.0-A5] 结算与税务说明 —— 12 号合规报告要求，佣金/权益页常驻可见 */
.tax-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background-color: var(--es-elevated, #151F2C);
  border-left: 4rpx solid var(--es-amber, #FFB020);
  border-radius: var(--radius-sm, 12rpx);
}

.tax-note-title {
  font-size: 24rpx;
  color: var(--es-txt-1, #F4F7FA);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tax-note-text {
  font-size: 22rpx;
  color: var(--es-txt-2, #AAB4BE);
  line-height: 1.6;
}
