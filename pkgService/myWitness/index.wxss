.page {
  min-height: 100vh;
  background: #03060C;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}
.card {
  background: #0B1220;
  border: 1rpx solid #1B2940;
  border-radius: 20rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #EAF2FF;
  margin-bottom: 16rpx;
}
.tip {
  font-size: 24rpx;
  color: #7B8591;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid #16223A;
}
.card-row .label { color: #7B8591; font-size: 26rpx; }
.card-row .value { color: #00BFFF; font-size: 28rpx; font-weight: 600; }
.code-box {
  background: #06101F;
  border: 1rpx dashed #2A3A55;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  letter-spacing: 2rpx;
  color: #EAF2FF;
  word-break: break-all;
}
.btn-row { display: flex; gap: 20rpx; margin-top: 20rpx; }
.btn {
  flex: 1;
  background: #00BFFF;
  color: #03060C;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 18rpx 0;
  line-height: 1.4;
}
.btn.ghost {
  background: transparent;
  color: #00BFFF;
  border: 1rpx solid #00BFFF;
}
.btn.small { flex: 0 0 180rpx; font-size: 26rpx; padding: 14rpx 0; }
.join-input-wrap { display: flex; gap: 16rpx; align-items: center; }
.join-input {
  flex: 1;
  background: #06101F;
  border: 1rpx solid #1B2940;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  color: #EAF2FF;
  font-size: 26rpx;
}
.tabs { display: flex; gap: 0; margin: 8rpx 0 20rpx; border-radius: 12rpx; overflow: hidden; border: 1rpx solid #1B2940; }
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #7B8591;
  background: #0B1220;
}
.tab.active { color: #03060C; background: #00BFFF; font-weight: 600; }
.list { margin-top: 8rpx; }
.item {
  background: #0B1220;
  border: 1rpx solid #1B2940;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.item-id { color: #EAF2FF; font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.item-meta { color: #7B8591; font-size: 24rpx; }
.empty { text-align: center; color: #5A6675; font-size: 26rpx; padding: 60rpx 0; }
.wall-entry {
  margin-top: 30rpx;
  text-align: center;
  color: #00BFFF;
  font-size: 28rpx;
  padding: 24rpx;
  border: 1rpx solid #16334A;
  border-radius: 16rpx;
  background: #07111F;
}
