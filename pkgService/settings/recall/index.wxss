/* pkgService/settings/recall/index.wxss · [V2.0-J3] 强提醒设置 */
.page {
  min-height: 100vh;
  background: var(--es-bg, #03060C);
  color: var(--es-text, #F4F7FA);
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.topbar { padding: 8rpx 4rpx 20rpx; }
.title { font-size: 38rpx; font-weight: 800; letter-spacing: 1rpx; }

.card {
  background: var(--es-surface, #0F1926);
  border: 1rpx solid var(--es-border, #4B5663);
  border-radius: 20rpx;
  padding: 26rpx 26rpx 28rpx;
  margin-bottom: 22rpx;
}

.card-h { display: flex; align-items: center; margin-bottom: 12rpx; }
.card-t { font-size: 28rpx; font-weight: 700; }

.badge {
  font-size: 20rpx; padding: 3rpx 12rpx; border-radius: 999rpx; margin-left: 14rpx;
}
.badge-sub { background: rgba(0, 191, 255,.15); color: var(--es-green, #00BFFF); }
.badge-ext { background: rgba(77,169,252,.15); color: var(--es-blue, #006CFF); }
.badge-oa { background: rgba(0, 191, 255,.18); color: var(--es-green, #00BFFF); border: 1rpx solid rgba(0, 191, 255,.4); }
.badge-cs { background: rgba(255,176,32,.15); color: var(--orange, #FFB020); }

/* 服务号关注引导 */
.oa-fallback { margin-top: 18rpx; padding: 18rpx; background: rgba(0, 191, 255,.05); border-radius: 14rpx; }
.oa-fb-t { font-size: 22rpx; color: var(--es-sub, #9AA4B2); display: block; margin-bottom: 10rpx; }
.oa-step { display: flex; align-items: center; font-size: 24rpx; padding: 8rpx 0; }
.oa-idx {
  width: 30rpx; height: 30rpx; border-radius: 50%; background: var(--es-green, #00BFFF);
  color: var(--es-bg, #03060C); font-size: 20rpx; font-weight: 800; text-align: center; line-height: 30rpx; margin-right: 14rpx; flex: none;
}
.oa-link { color: var(--es-green, #00BFFF); }
.oa-qr-box { margin-top: 14rpx; padding: 16rpx; background: var(--es-surface, #0F1926); border-radius: 12rpx; text-align: center; }
.oa-qr { width: 280rpx; height: 280rpx; background: var(--es-white, #F4F7FA); border-radius: 8rpx; }
.oa-qr-tip { font-size: 20rpx; color: var(--es-sub, #9AA4B2); display: block; margin-top: 10rpx; line-height: 1.5; }

.btn-oa {
  margin-top: 18rpx; font-size: 26rpx; color: var(--es-bg, #03060C); font-weight: 700;
  background: var(--es-green, #00BFFF); border-radius: 12rpx; padding: 16rpx 0;
}
.oa-done { margin-top: 16rpx; font-size: 24rpx; color: var(--es-safe, #00E5A0); }

/* 通道分工 */
.split { display: flex; gap: 18rpx; margin-top: 14rpx; }
.split-col { flex: 1; background: rgba(255,255,255,.03); border-radius: 12rpx; padding: 16rpx; }
.split-h { font-size: 22rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.split-h.ok { color: var(--es-safe, #00E5A0); }
.split-h.mid { color: var(--es-amber, #FFB020); }
.split-i { font-size: 22rpx; color: var(--es-sub, #9AA4B2); display: block; line-height: 1.8; }

.desc { font-size: 24rpx; line-height: 1.7; color: var(--es-sub, #9AA4B2); display: block; }
.hint { font-size: 21rpx; line-height: 1.6; color: var(--es-sub, #9AA4B2); display: block; margin-top: 10rpx; }

.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0;
}
.row-label { font-size: 26rpx; }

.divider { height: 1rpx; background: var(--es-border, #4B5663); margin: 14rpx 0 6rpx; }

.phone-box {
  margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx dashed var(--es-border, #4B5663);
  display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx;
}
.phone { font-size: 28rpx; font-weight: 700; color: var(--es-green, #00BFFF); }
.link { font-size: 24rpx; color: var(--es-red, #FF4D5E); }
.status { font-size: 20rpx; color: var(--es-sub, #9AA4B2); }

.tag-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.tag {
  font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 999rpx;
  background: rgba(0, 191, 255,.10); color: var(--es-green, #00BFFF);
  border: 1rpx solid rgba(0, 191, 255,.25);
}

.btn-ghost {
  margin-top: 16rpx; font-size: 24rpx; color: var(--es-green, #00BFFF);
  background: transparent; border: 1rpx solid rgba(0, 191, 255,.4);
  border-radius: 12rpx; padding: 14rpx 0; line-height: 1.4;
}
.btn-primary {
  margin-top: 12rpx; font-size: 26rpx; color: var(--es-bg, #03060C); font-weight: 700;
  background: var(--es-green, #00BFFF); border-radius: 12rpx; padding: 16rpx 0;
}

.notice { margin-top: 10rpx; padding: 18rpx 4rpx; }
.notice-txt {
  font-size: 21rpx; line-height: 1.7; color: var(--es-sub, #9AA4B2);
}
