/* pkgService/exchange/index.wxss —— 积分商城 */
.exchange {
  min-height: 100vh;
  background: #03060C;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.balance-bar {
  background: linear-gradient(135deg, #0a2a1a 0%, #031a12 100%);
  border: 1rpx solid #0e3a28;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
}
.balance-label {
  font-size: 24rpx;
  color: #7B8591;
}
.balance-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #00E0A1;
  line-height: 1.2;
  margin: 8rpx 0;
}
.balance-tip {
  font-size: 20rpx;
  color: #5d6b78;
  line-height: 1.5;
}

.list { display: flex; flex-direction: column; gap: 18rpx; }

.card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0a0f17;
  border: 1rpx solid #16202c;
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
}
.card-main { flex: 1; min-width: 0; }
.card-name {
  font-size: 30rpx;
  color: #EAF2FF;
  font-weight: 600;
}
.card-desc {
  font-size: 22rpx;
  color: #7B8591;
  margin-top: 8rpx;
  line-height: 1.4;
}
.tag-l2 {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 18rpx;
  color: #00E0A1;
  border: 1rpx solid #0e3a28;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.tag-room {
  color: #00BFFF;
  border-color: #0a3550;
}

.quick-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.quick-item {
  flex: 1;
  position: relative;
  background: linear-gradient(135deg, #0a2a1a 0%, #031a12 100%);
  border: 1rpx solid #0e3a28;
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
}
.quick-item.room {
  background: linear-gradient(135deg, #06223a 0%, #03101c 100%);
  border-color: #0a3550;
}
.quick-title {
  font-size: 30rpx;
  color: #EAF2FF;
  font-weight: 600;
}
.quick-sub {
  font-size: 20rpx;
  color: #7B8591;
  margin-top: 6rpx;
}
.quick-arrow {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #00BFFF;
}
.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}
.card-cost {
  font-size: 24rpx;
  color: #00BFFF;
  margin-bottom: 12rpx;
}
.redeem-btn {
  background: #00E0A1;
  color: #031a12;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 28rpx;
  margin: 0;
  line-height: 2.2;
}
.redeem-btn.disabled { background: #2a3340; color: #7B8591; }
.redeem-btn.locked { background: #1a232e; color: #5d6b78; }

.state {
  text-align: center;
  color: #7B8591;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.compliance-tip {
  margin-top: 36rpx;
  font-size: 20rpx;
  color: #5d6b78;
  line-height: 1.6;
  padding: 0 8rpx;
}

.rules-entry {
  position: relative;
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  background: #0a0f17;
  border: 1rpx solid #16202c;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
}
.rules-entry-t { font-size: 28rpx; color: #EAF2FF; font-weight: 600; }
.rules-entry-s { font-size: 20rpx; color: #7B8591; margin-top: 6rpx; }
.rules-entry-a {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #00E0A1;
}

/* 我的兑换码 */
.codes-block {
  margin-top: 32rpx;
  background: #0a0f17;
  border: 1rpx solid #16202c;
  border-radius: 18rpx;
  padding: 24rpx;
}
.codes-title {
  font-size: 26rpx;
  color: #EAF2FF;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #16202c;
}
.code-info { flex: 1; min-width: 0; }
.code-name { font-size: 24rpx; color: #9fb0c0; }
.code-val {
  font-size: 26rpx;
  color: #00E0A1;
  font-family: monospace;
  margin-top: 6rpx;
  word-break: break-all;
}
.copy-btn {
  background: #16202c;
  color: #00BFFF;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 0 24rpx;
  margin: 0 0 0 16rpx;
  line-height: 2.2;
}

/* 兑换成功弹码 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.modal {
  width: 560rpx;
  background: #0a0f17;
  border: 1rpx solid #0e3a28;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  text-align: center;
}
.modal-title { font-size: 32rpx; color: #EAF2FF; font-weight: 700; }
.modal-sub { font-size: 20rpx; color: #7B8591; margin-top: 12rpx; line-height: 1.5; }
.modal-code {
  font-size: 40rpx;
  color: #00E0A1;
  font-family: monospace;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin: 28rpx 0;
  word-break: break-all;
}
.modal-copy {
  background: #00E0A1;
  color: #031a12;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 0 40rpx;
  line-height: 2.4;
}
.modal-close {
  font-size: 24rpx;
  color: #7B8591;
  margin-top: 24rpx;
}
