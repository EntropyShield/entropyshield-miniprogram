/* pkgAcademy/pages/lesson.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: var(--es-bg, #03060C);
  color: var(--es-txt-1, #F4F7FA);
}
.ai-banner {
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-sm, 12rpx);
  background: rgba(0, 191, 255, .08);
  border: 1rpx solid rgba(0, 191, 255, .25);
  color: var(--es-green, #00BFFF);
  font-size: var(--fs-xs, 20rpx);
  line-height: 1.6;
}
.lesson-head { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 8rpx; }
.mod-tag { font-size: var(--fs-xs, 20rpx); color: var(--es-green, #00BFFF); }
.les-title { font-size: var(--fs-xl, 40rpx); font-weight: 800; color: var(--es-txt-1, #F4F7FA); line-height: 1.4; }
.unlock-tag { align-self: flex-start; font-size: var(--fs-xs, 20rpx); font-weight: 600; padding: 4rpx 14rpx; border-radius: 999rpx; }
.u-free { color: var(--es-green, #00BFFF); background: rgba(0, 191, 255, .12); }
.u-points { color: var(--es-amber, #FFB020); background: rgba(255, 176, 32, .12); }
.u-paid { color: var(--es-red, #FF4D5E); background: rgba(255, 77, 94, .12); }
.u-member { color: var(--es-blue, #006CFF); background: rgba(138, 160, 255, .12); }
.unlock-note { margin: 6rpx 0 18rpx; font-size: var(--fs-xs, 20rpx); color: var(--es-txt-3, #8E98A3); }

.blk { margin-bottom: 18rpx; padding: 24rpx; border-radius: var(--radius-md, 20rpx); background: var(--es-card, #07111E); border: 2rpx solid var(--es-line, #4B5663); }
.b-hero { background: linear-gradient(135deg, rgba(0, 191, 255,.16), rgba(0, 191, 255,.04)); border-color: rgba(0, 191, 255,.4); font-size: var(--fs-lg, 36rpx); font-weight: 800; color: var(--es-green, #00BFFF); line-height: 1.5; }
.b-hook { font-size: var(--fs-base, 28rpx); color: var(--es-txt-1, #F4F7FA); line-height: 1.85; }
.b-card { display: flex; flex-direction: column; gap: 10rpx; }
.card-title { font-size: var(--fs-base, 28rpx); font-weight: 700; color: var(--es-green, #00BFFF); }
.card-body { font-size: var(--fs-sm, 24rpx); color: var(--es-txt-2, #AAB4BE); line-height: 1.8; }
.b-story { background: rgba(138,160,255,.06); border-color: rgba(138,160,255,.25); }
.story-title { display: block; font-size: var(--fs-base, 28rpx); font-weight: 700; color: var(--es-blue, #006CFF); margin-bottom: 8rpx; }
.story-body { font-size: var(--fs-sm, 24rpx); color: var(--es-txt-2, #AAB4BE); line-height: 1.85; }
.b-quiz { background: rgba(255,176,32,.06); border-color: rgba(255,176,32,.25); }
.quiz-q { display: block; font-size: var(--fs-base, 28rpx); font-weight: 600; color: var(--es-txt-1, #F4F7FA); line-height: 1.7; margin-bottom: 10rpx; }
.quiz-a { display: block; font-size: var(--fs-sm, 24rpx); color: var(--es-amber, #FFB020); line-height: 1.8; }
.b-mnemonic { background: rgba(0, 191, 255,.08); border-color: rgba(0, 191, 255,.3); }
.mnemonic-label { display: block; font-size: var(--fs-xs, 20rpx); color: var(--es-green, #00BFFF); margin-bottom: 8rpx; }
.mnemonic-text { font-size: var(--fs-base, 28rpx); font-weight: 700; color: var(--es-txt-1, #F4F7FA); }
.b-action { background: rgba(0, 191, 255,.1); border-color: rgba(0, 191, 255,.4); }
.action-label { display: block; font-size: var(--fs-base, 28rpx); font-weight: 700; color: var(--es-green, #00BFFF); margin-bottom: 8rpx; }
.action-text { font-size: var(--fs-sm, 24rpx); color: var(--es-txt-1, #F4F7FA); line-height: 1.8; }
.b-disclaimer { font-size: var(--fs-xs, 20rpx); color: var(--es-txt-3, #8E98A3); line-height: 1.7; border-style: dashed; }

.done-bar { margin-top: 20rpx; }
.done-btn { background: linear-gradient(135deg, var(--es-safe, #00E5A0), var(--es-safe-deep, #0F6E56)); color: var(--es-on-green, #04140E); font-size: var(--fs-base, 28rpx); font-weight: 700; border-radius: var(--radius-sm, 12rpx); }
.done-btn::after { border: none; }
.done-flag { text-align: center; padding: 22rpx; color: var(--es-safe, #00E5A0); font-size: var(--fs-base, 28rpx); font-weight: 700; }

.empty { display: flex; align-items: center; justify-content: center; }
.empty-text { color: var(--es-txt-3, #8E98A3); font-size: var(--fs-base, 28rpx); }
